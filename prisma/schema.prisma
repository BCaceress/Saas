// ============================================================
// NoHub Market — Schema único (row-level multi-tenant)
// Um schema físico, um PrismaClient. Isolamento por `tenantId`.
//
// DUAS CAMADAS DE ISOLAMENTO (ver PRD §3):
//   1. Prisma Client Extension ($extends) + AsyncLocalStorage:
//      injeta tenantId em toda query automaticamente (impede WHERE esquecido).
//   2. Postgres RLS: policy por tabela + SET LOCAL app.current_tenant
//      dentro da transação — o banco recusa cruzar tenants (defesa em profundidade).
//
// ÍNDICES: sempre LIDERADOS por tenantId (ex.: [tenantId, sku]) — cada tenant
// toca só a sua fatia do B-tree; volume dos outros não atrapalha.
//
// ESTOQUE (Opção B — dois saldos):
//   estoqueFechado (un) + estoqueAberto (ml/g da unidade em uso).
//   Receita com estoqueAberto==0 -> abre 1: fechado-=1, aberto+=conteudoPorUnidade.
//   Venda fechada não lê o aberto ("aberta não vende fechada" sai de graça).
//   % da aberta = estoqueAberto / conteudoPorUnidade.
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled
  directUrl = env("DIRECT_URL") // Neon unpooled — usado nas migrations
}

// ============================================================
// CONTROLE / AUTH (mesmo banco)
// ============================================================

/// Planos de venda. O plano define o TETO do que o tenant pode usar; os toggles
/// `modulo*` definem o que ele de fato ligou. Add-ons (Tenant.addons) destravam
/// features fora do plano — usados no que tem custo variável (fiscal, totem).
/// Matriz plano → features → limites: src/lib/planos.ts (fonte única).
enum Plan {
  PRATA
  OURO
  DIAMANTE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

/// Perfis de acesso. ADMINISTRADOR é sempre do tenant inteiro (siteId null);
/// os demais são operacionais e podem ser restritos a uma loja.
enum Perfil {
  ADMINISTRADOR
  ESTOQUISTA
  CAIXA
  FINANCEIRO
  CONTADOR
}

enum TipoOperacao {
  AUTONOMO
  MERCADINHO
  CONVENIENCIA_BEBIDAS
}

enum Atendimento {
  SELF_SERVICE
  OPERADOR_PDV
}

// Controle de estoque no PDV: como a venda reage a saldo insuficiente.
enum ControleEstoquePdv {
  BLOQUEAR // não deixa vender sem saldo (padrão)
  CONFIRMAR // permite vender acima do saldo mediante confirmação do operador
  IGNORAR // vende sem validar saldo
}

/// Como a empresa decide o que precisa ser comprado. Escolhida no onboarding e
/// trocável em Configurações → Estoque. Nunca apaga dado: alternar a estratégia
/// só muda o que aparece na interface e como a sugestão de compra é calculada.
enum TipoControleEstoque {
  MINIMO // só estoque mínimo — repõe ao atingir o piso
  MINIMO_IDEAL // mínimo + ideal (padrão histórico do NoHub)
  ROTATIVIDADE // sem metas fixas: média diária de venda × dias de cobertura
}

enum Topologia {
  LOCAL
  CD_ABASTECE
  MISTO
}

model Tenant {
  id        String @id @default(cuid())
  subdomain String @unique // x.app.com -> resolvido no middleware
  nome      String

  plano       Plan         @default(PRATA)
  status      TenantStatus @default(TRIAL)
  trialEndsAt DateTime?

  /// Add-ons contratados por fora do plano (slugs de `Addon`, src/lib/planos.ts).
  /// Existem para o que tem custo variável ou por unidade: emissão fiscal
  /// (a Nuvem Fiscal cobra por documento) e autoatendimento (por totem).
  addons String[] @default([])

  /// Lojas contratadas além das que o plano já inclui (add-on `loja-extra`).
  lojasExtras Int @default(0)

  // Perfil da empresa (Configurações → Empresa)
  cnpj         String?
  razaoSocial  String?
  logoUrl      String? // logo da loja (exibida no totem/autoatendimento)
  telefone     String?
  emailContato String?
  cep          String?
  rua          String?
  numero       String?
  cidade       String?
  estado       String?

  // Onboarding -> defaults
  tipoOperacao TipoOperacao?
  atendimento  Atendimento?
  topologia    Topologia?
  numPontos    Int?

  // Toggles de módulo (lidos no middleware/menu)
  moduloPdv             Boolean @default(false)
  moduloFiscal          Boolean @default(false)
  moduloComodato        Boolean @default(false)
  moduloRota            Boolean @default(false)
  moduloAutoatendimento Boolean @default(false)

  // Autoatendimento (totem): PIN para sair do modo quiosque. null = saída livre.
  totemPinHash String?

  // Distribuição CD→loja: se true, recebimento exige contagem na loja (gera
  // estoque em trânsito); se false, expedição auto-confirma o recebimento.
  recebimentoExigeContagem Boolean @default(false)

  // Conferência cega: a tela do recebimento esconde a quantidade esperada até
  // o conferente digitar a dele. Mostrar o esperado transforma conferência em
  // "confirmar" — é assim que furto e erro de separação passam batido.
  conferenciaCega Boolean @default(false)

  // Fidelização / CRM: envio automático de cupom (risco + aniversário) via
  // WhatsApp. Desligado por padrão — o operador liga em Configurações.
  cupomAutomatico Boolean @default(false)
  cupomDiasRisco  Int     @default(25) // dias sem comprar → cliente em risco

  // Níveis do cliente por total gasto acumulado (Cobre é o nível-base, sempre
  // R$ 0 — não configurável). Ajustável em Configurações → Fidelização.
  tierBronzeMin   Int @default(200)
  tierPrataMin    Int @default(500)
  tierOuroMin     Int @default(2000)
  tierDiamanteMin Int @default(5000)

  // Estoque (Configurações → Estoque e alertas)
  /// Estratégia de controle. Default MINIMO_IDEAL = comportamento de sempre,
  /// então tenant antigo não muda de funcionamento ao migrar.
  tipoControleEstoque TipoControleEstoque @default(MINIMO_IDEAL)
  /// Janela de histórico usada para a média diária de venda (15/30/60/90).
  periodoMediaDias    Int                 @default(30)
  /// Dias de venda que a compra deve cobrir no modo ROTATIVIDADE (7/14/21/30).
  diasCobertura       Int                 @default(7)
  /// % da meta de cobertura abaixo da qual o estoque é "crítico" (e não só
  /// "baixo"). Régua de severidade compartilhada por sino, dashboard e compras.
  coberturaCriticaPct Int                 @default(30)

  estoqueMinimoPadrao Int                @default(0) // pré-preenche o mínimo ao cadastrar produto
  produtoParadoDias   Int                @default(45) // dias sem movimentação → alerta "parado"
  validadeAlertaDias  Int                @default(30) // dias de antecedência do alerta "vencendo"
  controleEstoquePdv  ControleEstoquePdv @default(BLOQUEAR) // como o PDV trata saldo insuficiente

  // Caixa / PDV (Configurações → Caixa)
  caixaFundoTroco   Decimal? @db.Decimal(10, 2) // sugestão de abertura
  caixaLimiteGaveta Decimal? @db.Decimal(10, 2) // acima disso, sugere sangria

  // ── Sino de alertas ──────────────────────────────────────────
  /// LEGADO: categorias desligadas pelo operador (AlertCategory[]). Só é lido
  /// como fallback de quem ainda não salvou a preferência nova — a partir da
  /// primeira gravação em `alertasConfig`, este array é esvaziado.
  alertasDesativados String[] @default([])

  /// Preferência POR TIPO de alerta: `{ "<AlertKind>": { ligado, prioridade } }`.
  /// Os tipos e seus padrões vivem em `src/lib/alertas/catalogo.ts`. É JSON e
  /// não tabela porque são poucas chaves conhecidas, lidas inteiras a cada
  /// abertura do sino — uma tabela cobraria um join sem entregar consulta.
  alertasConfig Json?

  /// Limiares cujo dono é o próprio alerta (os demais moram no ajuste que os
  /// origina: `produtoParadoDias`, `cupomDiasRisco`, `diasCobertura`…).
  inventarioAtrasoDias    Int @default(3) // inventário aberto vira "atrasado"
  novoSemMovDias          Int @default(7) // janela do aviso "recém cadastrado sem movimentação"
  // Carência antes de cobrar o XML de uma entrada lançada à mão: a nota do
  // fornecedor costuma chegar no dia seguinte, e avisar na mesma hora
  // transformaria o alerta em ruído diário.
  entradaSemDocumentoDias Int @default(3)
  saldoPendenteDias       Int @default(5) // pedido parcial sem decisão sobre o saldo

  /// Janela civilizada do push, em hora local (fora dela o job não notifica).
  pushHoraInicio Int @default(7)
  pushHoraFim    Int @default(21)

  onboardingDone Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  invites           Invite[]
  quotationLinks    QuotationLink[]
  subscription      Subscription?
  brands            Brand[]
  categories        Category[]
  subcategories     Subcategory[]
  fiscalProfiles    FiscalProfile[]
  storageLocations  StorageLocation[]
  suppliers         Supplier[]
  products          Product[]
  productViews      ProductView[]
  tags              Tag[]
  sites             Site[]
  customers         Customer[]
  comodatoAssets    ComodatoAsset[]
  containerTypes    ContainerType[]
  paymentProvider   PaymentProviderConfig?
  fiscalConfig      FiscalConfig?
  fiscalEmitentes   FiscalEmitente[]
  savedReports      SavedReport[]
  reportFavorites   ReportFavorite[]
  reportRuns        ReportRun[]
  reportSchedules   ReportSchedule[]
  reportPresets     ReportPreset[]
  pushSubscriptions PushSubscription[]
  promotions        ProductPromotion[]

  @@index([status])
}

/// Inscrição de push de um aparelho. Uma por (usuário × navegador): o
/// `endpoint` é a identidade do aparelho no serviço de push do fabricante.
///
/// Os alertas são computados ao vivo (lib/alertas/computar) — não existe tabela
/// de notificação. Por isso a deduplicação mora AQUI, em `alertasEnviados`: o
/// job grava os IDs que acabou de mandar e, na próxima rodada, só notifica o
/// que não está na lista.
model PushSubscription {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  /// URL do serviço de push. Único por aparelho.
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?

  /// IDs de AlertItem já notificados neste aparelho (ex.: "sem-estoque:<id>").
  /// O job grava a INTERSEÇÃO com os alertas atuais, não a união: um alerta que
  /// se resolve sai daqui e volta a notificar se reaparecer, e o array não
  /// cresce sem limite.
  alertasEnviados String[] @default([])

  /// Falhas consecutivas do serviço de push. 410/404 remove na hora; o resto
  /// acumula até o teto e então remove.
  falhas        Int       @default(0)
  ultimoEnvio   DateTime?
  /// Silencia este aparelho até a data (não usado ainda pela interface).
  silenciadoAte DateTime?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Chave composta e NÃO `@@unique([endpoint])`: o extension injeta tenantId
  /// no WHERE, e findUnique é proibido em tabela de negócio (ver CLAUDE.md).
  @@unique([tenantId, endpoint])
  @@index([tenantId])
  @@index([tenantId, userId])
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String

  /// Dono da conta: responde pela cobrança e não pode ser removido/desativado.
  /// NÃO é um perfil — poder vem de MembershipAccess.
  proprietario Boolean   @default(false)
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?

  createdAt DateTime @default(now())

  acessos MembershipAccess[]
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

/// Um acesso = um perfil, opcionalmente restrito a uma loja.
/// siteId null = vale para todas as lojas. Uma pessoa pode ter vários.
/// Ex.: { ESTOQUISTA, null } + { CAIXA, "loja-centro" }.
model MembershipAccess {
  id           String   @id @default(cuid())
  tenantId     String
  membershipId String
  perfil       Perfil
  siteId       String?
  criadoEm     DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  site       Site?      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Atenção: NULL não colide em Postgres — o índice parcial que impede duplicar
  // o acesso global está na migration (MembershipAccess_global_key).
  @@unique([membershipId, perfil, siteId])
  @@index([tenantId, siteId])
}

// Convite de equipe (tabela de CONTROLE, como Membership): criado em
// Configurações → Usuários; consumido no signup/OAuth quando o e-mail bate.
model Invite {
  id       String @id @default(cuid())
  tenantId String
  email    String

  /// Acessos que a pessoa recebe ao aceitar: [{ perfil, siteId | null }, …].
  /// Mesmo formato de MembershipAccess — validado por Zod antes de gravar.
  acessos Json @default("[]")

  /// Segredo do link /convite/<token>. Trocado a cada reenvio.
  token       String   @unique
  expiresAt   DateTime
  /// Quem convidou (User global) — só para exibir na tela.
  criadoPorId String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([email])
}

/// Ciclo de vida da assinatura no gateway.
///   PENDENTE     — checkout criado, primeiro pagamento ainda não confirmado
///   ATIVA        — em dia
///   INADIMPLENTE — cobrança recusada; ainda dentro do prazo de tolerância
///   CANCELADA    — encerrada (pelo lojista ou por inadimplência prolongada)
enum SubscriptionStatus {
  PENDENTE
  ATIVA
  INADIMPLENTE
  CANCELADA
}

/// Assinatura do SaaS — o que o LOJISTA paga para nós. Não confundir com
/// `Payment`, que é o que o CONSUMIDOR paga ao lojista no PDV.
///
/// O gateway (Mercado Pago) é a verdade sobre dinheiro; esta tabela é a
/// projeção local que o app consulta a cada requisição. Nada de consultar a
/// API do MP no caminho crítico — se o gateway cai, a loja não pode parar.
model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique
  plano    Plan

  status SubscriptionStatus @default(PENDENTE)

  /// "mercadopago" | "manual" (contrato fechado fora do app, cobrado por boleto)
  gateway     String?
  /// id do preapproval no gateway
  externalId  String?
  /// URL de checkout enquanto PENDENTE — o lojista volta nela para pagar.
  checkoutUrl String?

  /// Valor mensal fechado NA VENDA. Reajuste de tabela não pode mudar o que já
  /// foi contratado sem alguém decidir isso.
  valorMensal Decimal? @db.Decimal(10, 2)

  /// Add-ons cobrados junto (slugs de `Addon`, src/lib/planos.ts).
  addons String[] @default([])

  ultimaCobranca    DateTime?
  proximaCobranca   DateTime?
  /// Primeira falha do ciclo atual — base da contagem de tolerância.
  inadimplenteDesde DateTime?
  canceladaEm       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events SubscriptionEvent[]

  @@index([status])
  @@index([proximaCobranca])
}

/// Trilha do que o gateway mandou. Serve para dois propósitos práticos:
/// idempotência do webhook (`externalId` único) e suporte — quando o lojista
/// diz "eu paguei", alguém precisa conseguir ver o que chegou e quando.
model SubscriptionEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  tipo           String // payment.approved, payment.rejected, preapproval.cancelled…
  externalId     String?  @unique // id do evento/pagamento no gateway
  valor          Decimal? @db.Decimal(10, 2)
  detalhe        String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}

// Auth.js (NextAuth v5). User é GLOBAL; vínculo com tenant = Membership.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // provider Credentials
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  resetTokens PasswordResetToken[]
}

/// Recuperação de senha. Guardamos o HASH do token, nunca o token: um dump de
/// banco não pode virar troca de senha na conta de ninguém. Uso único
/// (`usedAt`) e vida curta — quem esquece a senha redefine em minutos, não em
/// dias. Tabela de controle: global, sem tenantId (login é no domínio raiz).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Contador de tentativas por chave (ex.: `login:email`, `reset:ip`). Vive no
/// banco de propósito: memória de processo não serve em serverless, onde cada
/// requisição pode cair em outra instância — o atacante só precisaria insistir.
model RateLimit {
  chave     String   @id
  contador  Int      @default(0)
  janelaFim DateTime
  updatedAt DateTime @updatedAt

  @@index([janelaFim])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// NEGÓCIO (toda tabela carrega tenantId p/ RLS + índice liderado por tenantId)
// ============================================================

enum ProductType {
  SIMPLES
  COMBO
  PERSONALIZADO
  INSUMO
}

enum BaseUnit {
  UN
  ML
  G
}

enum RecipeType {
  DRINK
  PRATO
  OUTRO
}

enum StorageType {
  AMBIENTE
  REFRIGERADO
  CONGELADO
}

enum SalesChannel {
  IFOOD
  MERCADO_LIVRE
  PROPRIO
}

enum SiteType {
  LOJA
  CD
}

enum MovementType {
  ENTRADA
  SAIDA
  AJUSTE
  TRANSFERENCIA
  ABERTURA
  PRODUCAO
  PERDA
  DEVOLUCAO_CLIENTE // cliente devolve → entra no estoque (+)
  DEVOLUCAO_FORNECEDOR // devolvido ao fornecedor → sai do estoque (−)
  ESTORNO // desfaz uma entrada lançada errada — sai do estoque (−)
}

enum PurchaseType {
  MANUAL
  FORNECEDOR
}

enum PurchaseMotivo {
  COMPRA_SEM_PEDIDO
  BONIFICACAO
  ESTOQUE_INICIAL
  TRANSFERENCIA
  BRINDE
  TROCA
  AMOSTRA
  SERVICO
}

// Tipo do item dentro do pedido de compra — separa o que é cobrado pelo
// fornecedor (COMPRA) do que entra no estoque sem custo. Modelado como enum
// (não checkbox) para crescer sem alterar a estrutura do pedido.
enum TipoItemPedido {
  COMPRA
  BONIFICACAO
  BRINDE
  TROCA
  AMOSTRA
  SERVICO
}

// Motivo específico de um item não-COMPRA (hoje só bonificação usa).
enum MotivoBonificacao {
  COMERCIAL
  CAMPANHA
  REPOSICAO
  TROCA
  CORTESIA
  OUTRO
}

enum PurchaseOrderStatus {
  RASCUNHO // em elaboração ⚪
  ENVIADO // enviado ao fornecedor 🔵
  AGUARDANDO // confirmado pelo fornecedor, aguardando entrega 🟡
  EM_TRANSITO // mercadoria a caminho 🟣
  CONFERENCIA // XML conciliado, conferência física em andamento 🔷
  RECEBIDO_PARCIAL // recebimento pendente (chegou em parte) 🟠
  RECEBIDO // concluído ✅
  CANCELADO // 🔴
}

/// O que aconteceu com o que faltou num pedido que chegou só em parte. Sem
/// isto um RECEBIDO_PARCIAL fica aberto para sempre e ninguém sabe se o resto
/// ainda vem, se o fornecedor cortou, ou se virou pedido novo.
enum SaldoPedidoResolucao {
  PENDENTE // ainda se espera o resto
  ENCERRADO // o que faltou não vem (corte do fornecedor)
  REPEDIDO // o saldo virou um pedido novo
}

/// De onde o pedido nasceu. Todo caminho de entrada gera um pedido — os
/// retroativos (XML, DFe, lançamento manual) existem para "de onde veio esta
/// mercadoria?" ter sempre resposta, e não só quando houve compra planejada.
enum PurchaseOrderOrigem {
  MANUAL // digitado na tela de pedidos
  COTACAO // decisão de uma cotação
  REPOSICAO // sugestão de reposição inteligente
  CARRINHO // comparador de cesta
  XML // XML importado sem pedido prévio
  DFE // NF-e capturada na SEFAZ / e-mail
  ENTRADA_MANUAL // lançamento direto no estoque
}

/// Situação de um título a pagar ao fornecedor.
enum AccountPayableStatus {
  ABERTO
  PAGO
  CANCELADO
}

/// De onde veio a baixa de um título: dinheiro que saiu, ou crédito de uma
/// devolução ao fornecedor. São coisas diferentes no extrato e no caixa.
enum BaixaOrigem {
  PAGAMENTO
  CREDITO_DEVOLUCAO
  AJUSTE
}

/// Situação de um título a receber. Espelha `AccountPayableStatus` de propósito:
/// as duas pontas do caixa se leem no mesmo vocabulário.
enum AccountReceivableStatus {
  ABERTO
  RECEBIDO
  CANCELADO
}

/// De onde nasceu o título a receber. Hoje só o lançamento manual existe de
/// verdade; VENDA_PRAZO fica reservado para quando o PDV tiver fiado, e
/// existir aqui evita migration no dia em que tiver.
enum AccountReceivableOrigem {
  MANUAL
  VENDA_PRAZO
  COMODATO
  OUTRO
}

enum SupplierReturnStatus {
  RASCUNHO
  CONFIRMADA
  CANCELADA
}

/// Por que a mercadoria voltou para o fornecedor.
enum SupplierReturnMotivo {
  AVARIA
  VALIDADE
  DIVERGENCIA // veio diferente do pedido/nota
  RECUSA // recusada no recebimento
  ACORDO_COMERCIAL
  OUTRO
}

enum RequisicaoStatus {
  ABERTA // loja pediu, aguardando o CD separar
  ATENDIDA // CD separou/expediu (gerou Transfer)
  CANCELADA
}

enum TransferStatus {
  SEPARANDO // criado, ainda não baixou do CD
  EXPEDIDO // baixou do CD, em trânsito (aguarda recebimento na loja)
  RECEBIDO // somou na loja (conferido ou auto-confirmado)
  CANCELADA
}

enum InventoryStatus {
  PROGRAMADO // agendado, ainda sem contagem
  ABERTO // contagem em andamento
  FECHADO // contado e ajustado
  CANCELADO
}

enum SelectionType {
  UNICA
  MULTIPLA
}

// ── Fase 4 (Vendas & Checkout) ──────────────────────────────
enum SaleOrigin {
  PDV // operador no balcão
  TOTEM // self-service
  APP // app próprio (self-service)
  IMPORTADA // histórico importado de outro sistema (não passou pelo PDV)
}

enum SaleStatus {
  ABERTA // carrinho em andamento
  PAGA // finalizada (baixa aplicada)
  CANCELADA
}

enum PaymentMethod {
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  PIX
  OUTRO
}

enum PaymentStatus {
  PENDENTE // aguardando confirmação (PIX/totem)
  PROCESSANDO // enviado ao terminal de cartão — aguardando adquirente
  CONFIRMADO
  RECUSADO // adquirente recusou (cartão)
  EXPIRADO // cobrança PIX expirou sem pagamento
  CANCELADO // operador cancelou antes da confirmação
  ESTORNADO
}

// Provedor de pagamento integrado (PIX dinâmico / maquininha).
enum PaymentProviderKind {
  MERCADO_PAGO
  STONE // PIX via Pagar.me (grupo Stone); cartão continua manual (sem API cloud de terminal)
  PAGSEGURO // PIX via API Pedidos PagBank; cartão continua manual (sem API cloud de terminal)
  SIMULADO // dev: aprova sozinho após alguns segundos
}

enum PaymentAmbiente {
  PRODUCAO
  SANDBOX // testes com token/API sandbox do PagBank — host de API diferente
}

enum CashSessionStatus {
  ABERTA
  FECHADA
}

enum CashMovementType {
  ABERTURA
  SANGRIA // retirada de dinheiro
  SUPRIMENTO // reforço de dinheiro
  FECHAMENTO
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
}

// Motivo do cupom enviado — dirige a mensagem e evita reenvio duplicado.
enum CouponReason {
  RISCO // cliente ativo parou de comprar
  ANIVERSARIO
  MANUAL
}

enum ComodatoAssetStatus {
  DISPONIVEL
  EMPRESTADO
  MANUTENCAO
  BAIXADO // fora de uso (vendido, perdido, sucata)
}

enum ContainerMovementType {
  ENTREGA // entregue ao cliente (saldo do cliente sobe)
  DEVOLUCAO // devolvido pelo cliente (saldo desce)
  AJUSTE // acerto manual (quantidade assinada)
}

model Brand {
  id              String @id @default(cuid())
  tenantId        String
  nome            String // exibição (maiúsculas na UI)
  nomeNormalizado String // uppercase+trim+sem pontuação+espaços colapsados

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, nomeNormalizado])
  @@index([tenantId])
}

model Category {
  id        String @id @default(cuid())
  tenantId  String
  nome      String
  skuPrefix String // "BEB"

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  inventories   Inventory[]

  @@unique([tenantId, skuPrefix])
  @@index([tenantId])
}

model Subcategory {
  id                     String       @id @default(cuid())
  tenantId               String
  categoryId             String
  nome                   String
  skuPrefix              String // "CER" — derivado do nome automaticamente
  ativo                  Boolean      @default(true)
  defaultFiscalProfileId String?
  defaultStorageType     StorageType?

  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category             Category       @relation(fields: [categoryId], references: [id])
  defaultFiscalProfile FiscalProfile? @relation(fields: [defaultFiscalProfileId], references: [id])
  products             Product[]

  @@unique([tenantId, categoryId, skuPrefix])
  @@index([tenantId])
  @@index([categoryId])
}

// Classificação fiscal reutilizável. É a FONTE do tributário: o produto
// aponta para um perfil em vez de repetir NCM/CST/CFOP em cada SKU (um
// mercadinho tem milhares de produtos e ~20 perfis). O que é por-item
// (GTIN tributável, fator de conversão) fica no Product.
model FiscalProfile {
  id              String   @id @default(cuid())
  tenantId        String
  nome            String // "Cerveja ST – RS"
  ncm             String
  cest            String?
  origem          String   @default("0")
  csosn           String?
  cst             String?
  cstPis          String?
  cstCofins       String?
  cstIpi          String?
  aliquotaIcms    Decimal? @db.Decimal(5, 2)
  aliquotaPis     Decimal? @db.Decimal(5, 2)
  aliquotaCofins  Decimal? @db.Decimal(5, 2)
  aliquotaIpi     Decimal? @db.Decimal(5, 2)
  // CFOP é da operação, não do SKU — mora aqui. Dentro do estado; a emissão
  // troca o 5xxx por 6xxx quando a UF do destinatário difere da do emitente.
  cfopSaida       String?
  cfopEntrada     String?
  codigoBeneficio String? // cBenef (UFs que exigem: RS, BA, PE…)
  temSt           Boolean  @default(false)
  precisaRevisao  Boolean  @default(false)

  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products               Product[]
  subcategoriesAsDefault Subcategory[]

  @@index([tenantId])
}

model StorageLocation {
  id       String      @id @default(cuid())
  tenantId String
  siteId   String
  nome     String
  tipo     StorageType
  ativo    Boolean     @default(true)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site   Site    @relation(fields: [siteId], references: [id])
  stocks Stock[]

  @@unique([tenantId, siteId, nome])
  @@index([tenantId])
  @@index([siteId])
}

model Supplier {
  id                   String       @id @default(cuid())
  tenantId             String
  cnpj                 String?
  razaoSocial          String
  nomeFantasia         String?
  email                String?
  telefone             String? // telefone/WhatsApp
  nomeContatoPrincipal String?
  website              String?
  logoUrl              String?
  cep                  String?
  logradouro           String?
  numero               String?
  complemento          String?
  bairro               String?
  municipio            String?
  codigoMunicipio      String? // IBGE (7 dígitos) — vem do XML de entrada
  uf                   String?
  ie                   String? // inscrição estadual
  indicadorIE          IndicadorIE?
  pedidoMinimo         Decimal?     @db.Decimal(12, 2) // valor mínimo de pedido exigido pelo fornecedor
  prazoPagamentoDias   Int? // condição negociada (30/45 dias…) — base do indicador financeiro
  observacoes          String? // anotações internas ("entrega só às quartas")
  ativo                Boolean      @default(true)

  // ── Relacionamento construído pelo XML da NF-e ──
  // Cada nota importada deste emitente atualiza estes campos. São cache do que
  // daria para recalcular lendo FiscalInbound — existem para a listagem e o
  // comparador de cotação responderem "quando comprei" sem varrer notas.
  crt               Int? // CRT do emitente: 1 Simples, 2 Simples-excesso, 3 normal, 4 MEI
  ultimaCompraEm    DateTime?
  ultimaCompraNota  String? // "12548/1"
  ultimaCompraValor Decimal?  @db.Decimal(12, 2)
  comprasNotas      Int       @default(0) // quantas NF-e deste fornecedor já entraram
  // Média (vencimento − emissão) das duplicatas das últimas notas. É o prazo
  // PRATICADO; `prazoPagamentoDias` continua sendo o negociado, digitado.
  prazoMedioDias    Int?

  // ── Compras com Fornecedores (catálogo/oferta) ──
  // Campos de vitrine: respondem "dá para receber tabela deste fornecedor e
  // por onde?" sem abrir a configuração do conector (SupplierIntegration).
  possuiIntegracao           Boolean                   @default(false)
  tipoIntegracao             SupplierIntegrationKind?
  situacaoIntegracao         SupplierIntegrationStatus @default(NAO_CONFIGURADA)
  ultimaSincronizacao        DateTime?
  aceitaImportacaoManual     Boolean                   @default(true)
  aceitaImportacaoAutomatica Boolean                   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products        ProductSupplier[]
  purchases       Purchase[]
  purchaseOrders  PurchaseOrder[]
  fiscalDocuments FiscalDocument[]
  fiscalInbounds  FiscalInbound[]
  itemMaps        SupplierItemMap[]

  integration  SupplierIntegration?
  catalogs     SupplierCatalog[]
  catalogItems SupplierCatalogItem[]
  offers       SupplierOffer[]
  imports      SupplierImport[]
  priceHistory SupplierPriceHistory[]
  cartItems    SupplierCartItem[]
  quotations   QuotationSupplier[]
  contacts     SupplierContact[]
  syncChanges  SupplierSyncChange[]
  fornecidos   SupplierProductHistory[]
  titulos      AccountPayable[]
  devolucoes   SupplierReturn[]

  @@unique([tenantId, cnpj])
  @@index([tenantId])
}

/// Pessoa de contato dentro do fornecedor — o vendedor, o representante, o
/// supervisor. O fornecedor é a EMPRESA; quem responde cotação é gente, e
/// quase nunca o telefone da recepção. Por isso a cotação sai para um contato,
/// não para "o fornecedor".
///
/// `principal` é o contato que já vem escolhido no envio. Só um por
/// fornecedor — a exclusividade é garantida na escrita (`definirPrincipal`),
/// não por índice: Postgres só faria isso com índice parcial, que o Prisma não
/// declara, e a regra tem que valer também no backfill.
model SupplierContact {
  id         String  @id @default(cuid())
  tenantId   String
  supplierId String
  nome       String
  cargo      String? // "Vendedor", "Representante", "Supervisor"
  telefone   String? // WhatsApp
  email      String?
  observacao String?
  principal  Boolean @default(false)
  ativo      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  convites QuotationSupplier[]
  envios   QuotationSend[]

  @@index([tenantId])
  @@index([supplierId])
  @@index([supplierId, principal])
}

// ============================================================
// SINCRONIZAÇÃO INTELIGENTE DO FORNECEDOR (XML da NF-e)
//
// O XML de entrada traz o cadastro do fornecedor mais atualizado do que
// qualquer digitação: razão social, IE, endereço e regime vêm da própria
// SEFAZ. Aproveitar isso é de graça — mas nem tudo pode entrar sozinho.
//
// Dado OFICIAL (bloco emit) entra automático: quem manda nele é a Receita.
// Telefone e e-mail do XML são do setor FISCAL do fornecedor, não do vendedor
// que atende o lojista — trocar o WhatsApp do representante por um 0800 de
// faturamento quebraria a cotação. Por isso viram SUGESTÃO com decisão.
// ============================================================

/// De onde veio a alteração e o que ela exige do operador.
enum SupplierSyncTipo {
  AUTOMATICO // dado oficial do XML — aplicado na hora
  SUGESTAO // precisa de decisão (telefone, e-mail, contato)
  HISTORICO // não mexe no cadastro: registra o relacionamento
}

enum SupplierSyncStatus {
  APLICADA
  PENDENTE
  IGNORADA
}

/// Uma linha da trilha de sincronização. Serve a dois usos ao mesmo tempo:
/// as PENDENTES são a fila de sugestões do painel; todas juntas são o
/// "histórico de alterações" da ficha do fornecedor.
model SupplierSyncChange {
  id         String  @id @default(cuid())
  tenantId   String
  supplierId String
  inboundId  String? // nota que originou (FiscalInbound)
  chave      String? // 44 dígitos — rastreia até o documento
  notaNumero String? // "12548/1"

  tipo   SupplierSyncTipo
  status SupplierSyncStatus @default(APLICADA)

  /// Chave do que mudou: nomeFantasia, razaoSocial, ie, crt, endereco,
  /// telefone, email, ultimaCompra, produtos, prazoMedio.
  campo         String
  /// Frase pronta para a tela ("Endereço atualizado"). Guardada porque o
  /// rótulo é do momento da mudança — regra nova não pode reescrever o passado.
  rotulo        String
  valorAnterior String?
  valorNovo     String?

  /// O que o operador escolheu numa sugestão: ATUALIZAR, CONTATO, PRINCIPAL,
  /// MANTER. Null enquanto pendente ou quando a mudança foi automática.
  decisao     String?
  decididoEm  DateTime?
  decididoPor String?

  createdAt DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([supplierId, createdAt])
  @@index([tenantId, status])
}

/// O que este fornecedor já entregou, item a item, como veio no XML. É o
/// registro bruto (SupplierItemMap guarda só o que o operador relacionou);
/// aqui fica TUDO que passou pela nota, inclusive o que nunca virou produto.
///
/// É a base de "quem já vendeu isto?" e "quanto paguei da última vez?" na hora
/// de montar a cotação.
model SupplierProductHistory {
  id               String  @id @default(cuid())
  tenantId         String
  supplierId       String
  codigoFornecedor String // cProd
  gtin             String?
  descricao        String
  ncm              String?
  cest             String?
  unidade          String  @default("UN")

  /// Preenchido quando o item já foi relacionado ao catálogo.
  productId String?

  vezes           Int      @default(1) // em quantas notas apareceu
  quantidadeTotal Decimal  @default(0) @db.Decimal(14, 3)
  /// Último preço unitário faturado, na unidade do fornecedor (uCom).
  ultimoPreco     Decimal? @db.Decimal(12, 4)
  ultimaNota      String?

  primeiraCompraEm DateTime @default(now())
  ultimaCompraEm   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, codigoFornecedor])
  @@index([tenantId])
  @@index([supplierId, ultimaCompraEm])
  @@index([productId])
  @@index([tenantId, gtin])
}

model ProductSupplier {
  id                 String   @id @default(cuid())
  tenantId           String
  productId          String
  supplierId         String
  codigoNoFornecedor String?
  custoFornecedor    Decimal? @db.Decimal(10, 2)
  isPrincipal        Boolean  @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@index([tenantId])
  @@index([supplierId])
}

model Product {
  id            String      @id @default(cuid())
  tenantId      String
  tipo          ProductType @default(SIMPLES)
  ean           String?
  nome          String
  sku           String // BEB-CER-6489
  brandId       String?
  subcategoryId String?
  imagemUrl     String?

  // Utilização do produto — as duas formas convivem (não são excludentes):
  //   vendaUnidade = vende a unidade fechada no PDV;
  //   fracionavel  = pode ser consumido parcialmente em drinks/receitas.
  // Ex.: Vodka 1L vende no caixa E rende doses de 50 ml.
  unidadeBase        BaseUnit @default(UN)
  vendaUnidade       Boolean  @default(true)
  fracionavel        Boolean  @default(false)
  conteudoPorUnidade Decimal? @db.Decimal(10, 2)
  // Dose sugerida ao adicionar o produto numa receita (na unidadeBase).
  dosePadrao         Decimal? @db.Decimal(10, 2)

  precoVenda Decimal? @db.Decimal(10, 2)
  custo      Decimal? @db.Decimal(10, 2)
  custoMedio Decimal? @db.Decimal(10, 2)

  fiscalProfileId    String?
  // Dados fiscais POR ITEM (o resto herda do FiscalProfile — não duplicar).
  // Recolhidos na UI: quem não vende por unidade tributável diferente nunca vê.
  gtinTributavel     String? // cEANTrib — difere do EAN quando se vende fração
  unidadeTributavel  String? // uTrib ("KG", "L") quando ≠ da unidade de venda
  fatorConversaoTrib Decimal? @db.Decimal(12, 4) // qTrib = quantidade × fator
  codigoAnp          String? // combustíveis
  restricaoIdade     Boolean  @default(false) // +18
  ativo              Boolean  @default(true)
  controlaEstoque    Boolean  @default(true) // false = INSUMO fora do controle de estoque (não aparece em /estoque)

  tipoReceita RecipeType?
  copoMl      Decimal?    @db.Decimal(10, 2) // tamanho do copo (drink) — tamanho único
  modoPreparo String?

  vendeOnline     Boolean  @default(false)
  pesoGramas      Int?
  alturaCm        Decimal? @db.Decimal(6, 2)
  larguraCm       Decimal? @db.Decimal(6, 2)
  comprimentoCm   Decimal? @db.Decimal(6, 2)
  descricaoOnline String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand         Brand?         @relation(fields: [brandId], references: [id])
  subcategory   Subcategory?   @relation(fields: [subcategoryId], references: [id])
  fiscalProfile FiscalProfile? @relation(fields: [fiscalProfileId], references: [id])

  stocks          Stock[]
  lots            StockLot[]
  packagings      ProductPackaging[]
  components      ProductComponent[]      @relation("ParentProduct")
  usedInRecipes   ProductComponent[]      @relation("ComponentProduct")
  componentGroups ProductComponentGroup[]
  variants        ProductVariant[]
  tags            ProductTag[]
  salesChannels   ProductSalesChannel[]
  suppliers       ProductSupplier[]

  promotions ProductPromotion[]

  catalogItems    SupplierCatalogItem[]
  catalogVinculos SupplierCatalogItemProduct[]
  priceHistory    SupplierPriceHistory[]
  cartItems       SupplierCartItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, ean])
  @@index([brandId])
  @@index([subcategoryId])
  /// Listagem padrão de /produtos: filtra por tenant+ativo e ordena por nome.
  /// Com este índice o Postgres entrega a página já ordenada, sem sort.
  @@index([tenantId, ativo, nome])
  /// Busca por trecho do nome ("heineken lata") vira ILIKE '%…%', que nenhum
  /// B-tree serve. GIN de trigramas resolve. Precisa da extensão pg_trgm —
  /// criada na migration 20260810_produtos_busca_visoes.
  @@index([nome(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Visão salva da listagem de produtos: filtro + colunas + ordenação com nome.
/// Fica no banco (e não no navegador) porque a visão é do operador, não da
/// máquina — quem monta "Parados 60d" no balcão quer achar no escritório.
model ProductView {
  id        String   @id @default(cuid())
  tenantId  String
  /// Dono da visão. Sem userId = visão da loja, visível a todo mundo.
  userId    String?
  nome      String
  /// Query string da tela (filtro + cols + sort), do jeito que vai pra URL.
  params    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, nome])
  @@index([tenantId])
}

/// Agenda de promoção de um produto: preço promocional com começo e fim.
///
/// Agenda e não campo no Product de propósito: "de sexta a domingo por R$ 4,99"
/// é a forma como o operador pensa a promoção, e um `precoPromocional` solto
/// exigiria alguém lembrar de desligá-lo na segunda. Fora da janela, o preço
/// que vale é o `Product.precoVenda` — a promoção nunca sobrescreve o cadastro.
///
/// `siteId` nulo = todas as lojas. Sobreposição é permitida (encarte por cima
/// de campanha longa); quem resolve o empate é `lib/promocoes`, que aplica a
/// promoção mais barata vigente.
model ProductPromotion {
  id        String  @id @default(cuid())
  tenantId  String
  productId String
  siteId    String?

  preco  Decimal  @db.Decimal(10, 2)
  inicio DateTime
  fim    DateTime
  ativo  Boolean  @default(true)
  /// Motivo/rótulo do encarte ("Fim de semana", "Queima de validade").
  nome   String?

  createdAt DateTime @default(now())
  createdBy String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  site    Site?   @relation(fields: [siteId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([siteId])
  /// Consulta do PDV/totem: promoções vigentes do tenant numa data.
  @@index([tenantId, ativo, inicio, fim])
}

model Stock {
  id         String  @id @default(cuid())
  tenantId   String
  productId  String
  siteId     String?
  locationId String?

  estoqueFechado Decimal @default(0) @db.Decimal(12, 3)
  estoqueAberto  Decimal @default(0) @db.Decimal(12, 3)
  estoqueMinimo  Decimal @default(0) @db.Decimal(12, 3)
  estoqueIdeal   Decimal @default(0) @db.Decimal(12, 3)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  site     Site?            @relation(fields: [siteId], references: [id])
  location StorageLocation? @relation(fields: [locationId], references: [id])

  @@unique([productId, siteId])
  @@index([tenantId])
  @@index([siteId])
  @@index([locationId])
}

model ProductPackaging {
  id              String  @id @default(cuid())
  tenantId        String
  productId       String
  nome            String // "Fardo", "Caixa", "Engradado"
  ean             String?
  fatorConversao  Decimal @db.Decimal(10, 3) // quantas UNIDADES base contém
  isCompraDefault Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
}

model ProductComponent {
  id                 String   @id @default(cuid())
  tenantId           String
  parentProductId    String
  componentProductId String
  quantidade         Decimal  @db.Decimal(12, 3)
  unidade            BaseUnit
  groupId            String?
  isDefault          Boolean  @default(false)
  acrescenta         Boolean  @default(true)
  acrescimoPreco     Decimal? @db.Decimal(10, 2)

  parent    Product                @relation("ParentProduct", fields: [parentProductId], references: [id], onDelete: Cascade)
  component Product                @relation("ComponentProduct", fields: [componentProductId], references: [id])
  group     ProductComponentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([parentProductId])
  @@index([componentProductId])
  @@index([groupId])
}

model ProductComponentGroup {
  id              String        @id @default(cuid())
  tenantId        String
  parentProductId String
  nome            String
  obrigatoria     Boolean       @default(true)
  tipoSelecao     SelectionType @default(UNICA)
  maxSelecoes     Int?
  ordem           Int           @default(0)

  parent     Product            @relation(fields: [parentProductId], references: [id], onDelete: Cascade)
  components ProductComponent[]

  @@index([tenantId])
  @@index([parentProductId])
}

// ------------------------------------------------------------
// VARIAÇÃO DE TAMANHO (Fase 2) — só p/ PERSONALIZADO
// Tamanho de copo/porção como FATOR DE ESCALA sobre a ficha base.
// Doses por tamanho = quantidade do ProductComponent × fatorEscala.
// precoVenda nulo => derivado (preço base × fatorEscala).
// ------------------------------------------------------------

model ProductVariant {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String // o PERSONALIZADO
  nome        String // "P", "M", "G", "300ml"...
  volumeMl    Decimal? @db.Decimal(10, 2) // tamanho do copo (drink)
  fatorEscala Decimal  @default(1) @db.Decimal(6, 3) // multiplica as doses da ficha base
  precoVenda  Decimal? @db.Decimal(10, 2) // nulo => derivado
  isDefault   Boolean  @default(false)
  ativo       Boolean  @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, nome])
  @@index([tenantId])
  @@index([productId])
}

model Tag {
  id       String @id @default(cuid())
  tenantId String
  nome     String

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductTag[]

  @@unique([tenantId, nome])
  @@index([tenantId])
}

model ProductTag {
  tenantId  String
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tenantId])
  @@index([tagId])
}

model ProductSalesChannel {
  id             String       @id @default(cuid())
  tenantId       String
  productId      String
  canal          SalesChannel
  precoCanal     Decimal?     @db.Decimal(10, 2)
  descricaoCanal String?
  ativo          Boolean      @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, canal])
  @@index([tenantId])
}

// ============================================================
// FASE 3 — SITES, ESTOQUE E MOVIMENTAÇÃO
// ============================================================

model Site {
  id       String   @id @default(cuid())
  tenantId String
  nome     String
  tipo     SiteType @default(LOJA)
  ativo    Boolean  @default(true)

  // Endereço (opcional)
  cep    String?
  rua    String?
  numero String?
  cidade String?
  estado String?

  // Estoque: próprio ou abastecido por CD
  estoquePropio   Boolean @default(true)
  cdAbastecedorId String?

  // Venda restrita p/ maiores de 18 (PDV): só se aplica a LOJA — CD não vende.
  controleIdade Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cdAbastecedor      Site?               @relation("CDAbastecimento", fields: [cdAbastecedorId], references: [id], onDelete: SetNull)
  lojasCom           Site[]              @relation("CDAbastecimento")
  stocks             Stock[]
  storageLocations   StorageLocation[]
  purchases          Purchase[]
  purchaseOrders     PurchaseOrder[]
  productions        Production[]
  transfersOut       Transfer[]          @relation("TransferOrigem")
  transfersIn        Transfer[]          @relation("TransferDestino")
  requisicoesOrigem  Requisicao[]        @relation("RequisicaoOrigem")
  requisicoesDestino Requisicao[]        @relation("RequisicaoDestino")
  inventories        Inventory[]
  sales              Sale[]
  cashSessions       CashSession[]
  paymentMethods     SitePaymentMethod[]
  acessos            MembershipAccess[]
  totemDevices       TotemDevice[]
  paymentTerminals   PaymentTerminal[]
  fiscalEmitente     FiscalEmitente?
  fiscalSeries       FiscalSerie[]
  fiscalDocuments    FiscalDocument[]
  fiscalInbounds     FiscalInbound[]
  quotations         Quotation[]
  promotions         ProductPromotion[]
  fiscalEmailInboxes FiscalEmailInbox[]
  devolucoes         SupplierReturn[]

  @@unique([tenantId, nome])
  @@index([tenantId])
  @@index([cdAbastecedorId])
}

// Razão append-only: toda mudança de saldo = uma linha.
// Stock (saldo corrente por produto × site) é atualizado na mesma transação.
model StockMovement {
  id        String       @id @default(cuid())
  tenantId  String
  siteId    String
  productId String
  tipo      MovementType

  deltaFechado Decimal @default(0) @db.Decimal(12, 3)
  deltaAberto  Decimal @default(0) @db.Decimal(12, 3)

  custoUnitario Decimal? @db.Decimal(10, 2)

  purchaseId   String?
  transferId   String?
  productionId String?
  saleId       String?
  lotId        String? // lote consumido (FEFO) ou criado (entrada) — rastreabilidade
  observacao   String?

  createdAt DateTime @default(now())
  createdBy String?

  lot StockLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([siteId])
  @@index([productId])
  @@index([tipo])
  @@index([transferId])
  @@index([productionId])
  @@index([saleId])
  @@index([lotId])
  @@index([createdAt])
}

// Lote de estoque fechado (unidades lacradas) com validade. FEFO: consumo
// puxa o lote de validade mais próxima primeiro (nulos por último).
// Invariante: soma de StockLot.quantidade por (produto × site) == Stock.estoqueFechado.
// Saldo aberto/fracionado (ml de drink) NÃO é rastreado por lote.
model StockLot {
  id        String @id @default(cuid())
  tenantId  String
  siteId    String
  productId String

  lote       String? // código do lote / nº da nota
  validade   DateTime? // vencimento (opcional)
  quantidade Decimal   @default(0) @db.Decimal(12, 3) // saldo fechado restante neste lote

  custoUnitario Decimal?  @db.Decimal(10, 2)
  purchaseId    String?
  esgotadoEm    DateTime? // quando zerou

  createdAt DateTime @default(now())
  createdBy String?

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@index([tenantId])
  @@index([siteId])
  @@index([productId])
  @@index([tenantId, siteId, productId])
  @@index([validade])
}

model Purchase {
  id              String          @id @default(cuid())
  tenantId        String
  siteId          String
  tipo            PurchaseType    @default(MANUAL)
  motivo          PurchaseMotivo?
  supplierId      String?
  purchaseOrderId String? // entrada gerada pela conferência de um pedido de compra
  numeroNota      String?
  data            DateTime        @default(now())
  observacao      String?
  createdAt       DateTime        @default(now())
  createdBy       String?

  // Entrada lançada à mão sem documento: fica marcada esperando o XML que vai
  // chegar depois (upload, e-mail ou SEFAZ). Sem isto, a mesma mercadoria
  // entraria duas vezes — uma pelo lançamento, outra pela nota.
  aguardandoDocumento  Boolean   @default(false)
  chaveNfe             String? // chave da NF-e que documentou esta entrada
  documentoVinculadoEm DateTime?

  // Entrada desfeita. Não apagamos a linha: a razão de estoque é append-only e
  // o estorno é um FATO — quem lançou errado, quem desfez e por quê. Apagar
  // deixaria um buraco que ninguém consegue explicar seis meses depois.
  estornadaEm   DateTime?
  estornoMotivo String?
  estornadaPor  String?

  site          Site             @relation(fields: [siteId], references: [id])
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  items         PurchaseItem[]
  fiscalDocs    FiscalDocument[]
  fiscalInbound FiscalInbound?
  titulos       AccountPayable[]
  devolucoes    SupplierReturn[]

  @@index([tenantId])
  @@index([siteId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([tenantId, aguardandoDocumento])
  @@index([chaveNfe])
}

// Pedido de compra ao fornecedor (PC-00125). Ciclo: rascunho → enviado →
// aguardando → recebido (parcial/total). A conferência no recebimento gera
// a(s) Purchase(s) de entrada que somam no estoque e atualiza qtdRecebida.
model PurchaseOrder {
  id               String              @id @default(cuid())
  tenantId         String
  siteId           String // destino: onde a mercadoria entra
  supplierId       String
  numero           String // PC-00125 (sequencial por tenant)
  status           PurchaseOrderStatus @default(RASCUNHO)
  origem           PurchaseOrderOrigem @default(MANUAL)
  previsaoEntrega  DateTime?
  valorTotal       Decimal             @default(0) @db.Decimal(12, 2) // soma cacheada dos itens
  observacao       String?
  financeiroGerado Boolean             @default(false) // títulos a pagar já emitidos

  // Cotação que originou. Uma cotação pode virar N pedidos (um por fornecedor
  // vencedor), então o vínculo mora aqui e não na cotação.
  quotationId String?

  // Saldo do que chegou só em parte. `origemPedidoId` encadeia o backorder:
  // pedido novo aponta para o pedido cujo corte o gerou.
  origemPedidoId   String?
  saldoResolucao   SaldoPedidoResolucao @default(PENDENTE)
  saldoResolvidoEm DateTime?
  saldoMotivo      String?
  enviadoEm        DateTime?
  confirmadoEm     DateTime?
  emTransitoEm     DateTime?
  recebidoEm       DateTime?
  canceladoEm      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt // última mudança (status, itens…)
  createdBy        String?

  site         Site                         @relation(fields: [siteId], references: [id])
  supplier     Supplier                     @relation(fields: [supplierId], references: [id])
  quotation    Quotation?                   @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  origemPedido PurchaseOrder?               @relation("SaldoPedido", fields: [origemPedidoId], references: [id], onDelete: SetNull)
  pedidosSaldo PurchaseOrder[]              @relation("SaldoPedido")
  items        PurchaseOrderItem[]
  entradas     Purchase[]
  inbounds     FiscalInbound[]
  conciliacao  PurchaseReconciliationItem[]
  eventos      PurchaseEvent[]
  titulos      AccountPayable[]
  devolucoes   SupplierReturn[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([siteId])
  @@index([supplierId])
  @@index([status])
  @@index([quotationId])
  @@index([origemPedidoId])
  @@index([tenantId, status, saldoResolucao])
}

model PurchaseOrderItem {
  id                String             @id @default(cuid())
  tenantId          String
  purchaseOrderId   String
  productId         String
  packagingId       String? // unidade de compra (caixa, fardo…)
  tipo              TipoItemPedido     @default(COMPRA)
  motivoBonificacao MotivoBonificacao? // só para tipo != COMPRA
  qtdPedida         Decimal            @db.Decimal(12, 3)
  custoUnitario     Decimal            @default(0) @db.Decimal(12, 2) // custo por unidade de compra — sempre 0 quando tipo != COMPRA
  qtdRecebida       Decimal            @default(0) @db.Decimal(12, 3) // acumulado conferido
  observacao        String? // nota do item ("trocar por validade longa", etc.)

  purchaseOrder PurchaseOrder                @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  conciliacao   PurchaseReconciliationItem[]

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([productId])
}

model PurchaseItem {
  id          String  @id @default(cuid())
  tenantId    String
  purchaseId  String
  productId   String
  packagingId String?
  quantidade  Decimal @db.Decimal(12, 3)
  custoTotal  Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([purchaseId])
  @@index([productId])
}

/// Contador de documento por tenant. Existe porque `count() + 1` não é
/// sequencial: dois operadores criando pedido no mesmo segundo leem a MESMA
/// contagem e o segundo estoura o unique de `numero`. Aqui o incremento é um
/// `UPDATE … RETURNING` atômico — o banco serializa, não a esperança.
///
/// `tipo` é o prefixo do documento ("PC", "COT", "DEV"). Uma linha por tipo,
/// por tenant; nunca é apagada, e o valor só sobe.
model DocumentCounter {
  tenantId String
  tipo     String // "PC" | "COT" | "DEV"
  valor    Int    @default(0)

  @@id([tenantId, tipo])
  @@index([tenantId])
}

// ============================================================
// FINANCEIRO DE COMPRAS E DEVOLUÇÃO AO FORNECEDOR
//
// A mercadoria que entra tem duas consequências que o estoque sozinho não
// cobre: o dinheiro que vai sair (AccountPayable) e a mercadoria que volta
// (SupplierReturn). Ambos penduram no mesmo documento de compra.
// ============================================================

/// Título a pagar ao fornecedor. Nasce das duplicatas da NF-e — uma linha por
/// parcela do boleto — ou, quando a nota não traz duplicata, como parcela
/// única no vencimento derivado do prazo do fornecedor. É o elo entre a
/// mercadoria que entrou e o dinheiro que sai.
model AccountPayable {
  id              String               @id @default(cuid())
  tenantId        String
  supplierId      String?
  purchaseId      String?
  purchaseOrderId String?
  inboundId       String?
  numeroDocumento String? // "12548/1" — nota que originou
  parcela         String? // nDup da NF-e ("001")
  descricao       String
  vencimento      DateTime
  valor           Decimal              @db.Decimal(12, 2)
  valorPago       Decimal              @default(0) @db.Decimal(12, 2)
  status          AccountPayableStatus @default(ABERTO)
  pagoEm          DateTime?
  observacao      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdBy       String?

  supplier      Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchase      Purchase?               @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  inbound       FiscalInbound?          @relation(fields: [inboundId], references: [id], onDelete: SetNull)
  baixas        AccountPayablePayment[]

  @@index([tenantId])
  @@index([tenantId, status, vencimento])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([purchaseOrderId])
  @@index([inboundId])
}

/// Cada baixa de um título, com autor e data. `AccountPayable.valorPago` é o
/// saldo cacheado; a VERDADE de quem pagou o quê, quando, mora aqui.
///
/// Sem isto, dinheiro saía sem autor: o título virava PAGO e não havia como
/// responder "quem deu baixa nisso?" — a pergunta que só aparece no dia em que
/// o boleto foi pago duas vezes.
model AccountPayablePayment {
  id         String      @id @default(cuid())
  tenantId   String
  payableId  String
  origem     BaixaOrigem @default(PAGAMENTO)
  valor      Decimal     @db.Decimal(12, 2)
  pagoEm     DateTime
  /// Devolução que gerou o crédito, quando `origem = CREDITO_DEVOLUCAO`.
  returnId   String?
  observacao String?
  createdAt  DateTime    @default(now())
  createdBy  String?

  titulo AccountPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, pagoEm])
  @@index([payableId])
}

/// Título a receber. A outra metade do caixa: sem ela, "dia 10 eu tenho
/// dinheiro para o boleto?" não tem resposta — só se enxergava o que sai.
///
/// Hoje a origem prática é o lançamento manual (venda a prazo para PJ,
/// comodato, aluguel de espaço). Quando o PDV ganhar fiado, a venda passa a
/// gerar título aqui pelo mesmo caminho que a NF-e gera conta a pagar.
model AccountReceivable {
  id              String                  @id @default(cuid())
  tenantId        String
  customerId      String?
  saleId          String?
  origem          AccountReceivableOrigem @default(MANUAL)
  numeroDocumento String?
  parcela         String?
  descricao       String
  vencimento      DateTime
  valor           Decimal                 @db.Decimal(12, 2)
  valorRecebido   Decimal                 @default(0) @db.Decimal(12, 2)
  status          AccountReceivableStatus @default(ABERTO)
  recebidoEm      DateTime?
  observacao      String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  createdBy       String?

  customer Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale     Sale?                      @relation(fields: [saleId], references: [id], onDelete: SetNull)
  baixas   AccountReceivablePayment[]

  @@index([tenantId])
  @@index([tenantId, status, vencimento])
  @@index([customerId])
  @@index([saleId])
}

/// Cada recebimento de um título, com autor e data — espelho de
/// `AccountPayablePayment`. `valorRecebido` é saldo cacheado; a verdade mora aqui.
model AccountReceivablePayment {
  id           String      @id @default(cuid())
  tenantId     String
  receivableId String
  origem       BaixaOrigem @default(PAGAMENTO)
  valor        Decimal     @db.Decimal(12, 2)
  recebidoEm   DateTime
  observacao   String?
  createdAt    DateTime    @default(now())
  createdBy    String?

  titulo AccountReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, recebidoEm])
  @@index([receivableId])
}

/// Devolução ao fornecedor — o inverso do recebimento. Sai do estoque, aponta
/// para a entrada/nota que trouxe a mercadoria e, quando há título em aberto,
/// abate o que se deve. Só CONFIRMADA movimenta estoque.
model SupplierReturn {
  id               String               @id @default(cuid())
  tenantId         String
  siteId           String
  supplierId       String
  numero           String // DEV-00012 (sequencial por tenant)
  status           SupplierReturnStatus @default(RASCUNHO)
  motivo           SupplierReturnMotivo @default(OUTRO)
  purchaseId       String? // entrada que trouxe a mercadoria
  purchaseOrderId  String? // pedido de origem, quando houve
  inboundId        String? // nota de entrada de origem
  numeroNota       String? // nota de devolução emitida por nós
  chaveNfe         String?
  /// NF-e de devolução emitida pelo módulo fiscal. Nulo = nota digitada à mão
  /// (ou ainda não emitida) — os dois casos existem no mundo real.
  fiscalDocumentId String?              @unique
  observacao       String // motivo em texto — obrigatório, é o que o fornecedor lê
  valorTotal       Decimal              @default(0) @db.Decimal(12, 2)
  confirmadaEm     DateTime?
  canceladaEm      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdBy        String?

  site           Site                 @relation(fields: [siteId], references: [id])
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  purchase       Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseOrder  PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  inbound        FiscalInbound?       @relation(fields: [inboundId], references: [id], onDelete: SetNull)
  fiscalDocument FiscalDocument?      @relation(fields: [fiscalDocumentId], references: [id], onDelete: SetNull)
  items          SupplierReturnItem[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([siteId])
  @@index([supplierId])
  @@index([purchaseId])
}

model SupplierReturnItem {
  id            String  @id @default(cuid())
  tenantId      String
  returnId      String
  productId     String
  quantidade    Decimal @db.Decimal(12, 3) // sempre em unidade base
  custoUnitario Decimal @default(0) @db.Decimal(12, 2)
  observacao    String?

  devolucao SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([returnId])
  @@index([productId])
}

model Transfer {
  id             String         @id @default(cuid())
  tenantId       String
  origemSiteId   String
  destinoSiteId  String
  status         TransferStatus @default(RECEBIDO) // default RECEBIDO p/ não quebrar linhas atômicas antigas
  requisicaoId   String?        @unique
  data           DateTime       @default(now())
  expedidoEm     DateTime?
  recebidoEm     DateTime?
  temDivergencia Boolean        @default(false)
  observacao     String?
  createdAt      DateTime       @default(now())
  createdBy      String?

  origem     Site           @relation("TransferOrigem", fields: [origemSiteId], references: [id])
  destino    Site           @relation("TransferDestino", fields: [destinoSiteId], references: [id])
  requisicao Requisicao?    @relation(fields: [requisicaoId], references: [id])
  items      TransferItem[]

  @@index([tenantId])
  @@index([origemSiteId])
  @@index([destinoSiteId])
  @@index([status])
}

model TransferItem {
  id          String   @id @default(cuid())
  tenantId    String
  transferId  String
  productId   String
  quantidade  Decimal  @db.Decimal(12, 3) // qtd solicitada/planejada na transferência
  qtdExpedida Decimal? @db.Decimal(12, 3) // baixado do CD na expedição
  qtdRecebida Decimal? @db.Decimal(12, 3) // contado na loja no recebimento
  // Lotes consumidos no CD (validade/lote/custo/qtd) — replay no recebimento
  // para a loja recriar os lotes com a mesma validade (transferência em trânsito).
  lotesInfo   Json?

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([transferId])
  @@index([productId])
}

// Requisição interna: loja (destino) pede ao CD (origem). Sem aprovação —
// cai direto pro CD separar/expedir, o que gera o Transfer ligado.
model Requisicao {
  id            String           @id @default(cuid())
  tenantId      String
  origemSiteId  String // CD que atende
  destinoSiteId String // loja que pede
  status        RequisicaoStatus @default(ABERTA)
  observacao    String?
  createdAt     DateTime         @default(now())
  createdBy     String?
  atendidaEm    DateTime?

  origem   Site             @relation("RequisicaoOrigem", fields: [origemSiteId], references: [id])
  destino  Site             @relation("RequisicaoDestino", fields: [destinoSiteId], references: [id])
  items    RequisicaoItem[]
  transfer Transfer?

  @@index([tenantId])
  @@index([origemSiteId])
  @@index([destinoSiteId])
  @@index([status])
}

model RequisicaoItem {
  id            String   @id @default(cuid())
  tenantId      String
  requisicaoId  String
  productId     String
  qtdSolicitada Decimal  @db.Decimal(12, 3)
  qtdAtendida   Decimal? @db.Decimal(12, 3) // CD pode separar menos se faltar saldo

  requisicao Requisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([requisicaoId])
  @@index([productId])
}

enum InventoryEscopo {
  COMPLETO // todo o estoque do site
  CATEGORIA // produtos de uma categoria
  PRODUTOS // lista específica de produtos
}

// Inventário (contagem). É programado primeiro (sem tirar snapshot); só ao
// iniciar (ação explícita do usuário) fotografa o saldo por produto no site.
// No fechamento, a divergência (contado − saldo atual) gera um AJUSTE no razão.
model Inventory {
  id               String          @id @default(cuid())
  tenantId         String
  siteId           String
  status           InventoryStatus @default(PROGRAMADO)
  escopoTipo       InventoryEscopo @default(COMPLETO)
  categoryId       String? // quando escopoTipo = CATEGORIA
  escopoProdutoIds String[]        @default([]) // quando escopoTipo = PRODUTOS (antes de iniciar)
  modoCego         Boolean         @default(false) // contador não vê o saldo do sistema até fechar
  dataProgramada   DateTime // data (+ horário, se informado) planejada para realizar
  recorrente       Boolean         @default(false) // ao fechar, agenda automaticamente a próxima ocorrência
  diasSemana       Int[]           @default([]) // 0=domingo..6=sábado — dias da recorrência semanal (pode ter mais de um)
  responsavelId    String? // userId do responsável designado (opcional)
  observacao       String?
  createdAt        DateTime        @default(now())
  createdBy        String?
  iniciadoEm       DateTime? // quando a contagem foi de fato aberta (snapshot tirado)
  fechadoEm        DateTime?
  fechadoPor       String? // userId de quem finalizou a contagem

  site     Site            @relation(fields: [siteId], references: [id])
  category Category?       @relation(fields: [categoryId], references: [id])
  items    InventoryItem[]

  @@index([tenantId])
  @@index([siteId])
  @@index([status])
}

model InventoryItem {
  id          String   @id @default(cuid())
  tenantId    String
  inventoryId String
  productId   String
  qtdSistema  Decimal  @db.Decimal(12, 3) // snapshot na abertura
  qtdContada  Decimal? @db.Decimal(12, 3) // contagem física

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inventoryId])
  @@index([productId])
}

model Production {
  id         String   @id @default(cuid())
  tenantId   String
  siteId     String
  productId  String
  variantId  String?
  quantidade Int      @default(1)
  saleId     String? // se a produção foi disparada por uma venda
  data       DateTime @default(now())
  observacao String?
  createdAt  DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id])

  @@index([tenantId])
  @@index([siteId])
  @@index([productId])
  @@index([saleId])
}

// ============================================================
// FASE 4 — VENDAS / CHECKOUT
// Dois sabores sobre a mesma base: PDV (operador) e self-service (totem/app).
// Finalizar a venda dispara a baixa de estoque (SAIDA / PRODUCAO) no site.
// ============================================================

model Sale {
  id             String     @id @default(cuid())
  tenantId       String
  siteId         String
  origem         SaleOrigin @default(PDV)
  status         SaleStatus @default(ABERTA)
  cashSessionId  String? // só PDV
  operatorUserId String? // só PDV
  customerId     String? // cliente identificado (fidelização) — opcional
  totemDeviceId  String? // terminal de autoatendimento que originou a venda

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  desconto Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  maiorIdadeConfirmada Boolean @default(false) // +18 confirmado no fechamento

  // "CPF na nota" digitado no fechamento — vai ao dest da NFC-e sem criar um
  // Customer. O caso do balcão: o cliente quer CPF na nota, não quer cadastro.
  // Só dígitos. Cliente identificado (customerId) tem prioridade.
  cpfNota String?

  // Venda criada OFFLINE no PDV e sincronizada depois. O id é gerado no cliente
  // (uuid) e é a chave de IDEMPOTÊNCIA da sincronização: reenvio não duplica a
  // venda. Null = venda nasceu online (o caso normal).
  clientId String? @unique

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  site        Site                @relation(fields: [siteId], references: [id])
  cashSession CashSession?        @relation(fields: [cashSessionId], references: [id])
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  totemDevice TotemDevice?        @relation(fields: [totemDeviceId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  payments    Payment[]
  fiscalDocs  FiscalDocument[]
  titulos     AccountReceivable[]

  @@index([tenantId])
  @@index([siteId])
  @@index([cashSessionId])
  @@index([customerId])
  @@index([totemDeviceId])
  @@index([status])
  @@index([createdAt])
  // O giro junta Sale por status='PAGA' e recorta por paidAt. Os índices soltos
  // de status e createdAt não servem: um não filtra data, o outro é da coluna
  // errada (createdAt ≠ paidAt).
  @@index([tenantId, status, paidAt])
}

// Terminal físico de autoatendimento. Registrado pelo quiosque no primeiro
// uso (id fica no localStorage do aparelho); heartbeat mantém lastSeenAt —
// "ativo" = visto nos últimos 2 minutos (fila do PDV).
model TotemDevice {
  id         String   @id @default(cuid())
  tenantId   String
  siteId     String
  nome       String // "Terminal 01"
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  site  Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sales Sale[]

  @@index([tenantId])
  @@index([siteId])
}

model SaleItem {
  id            String  @id @default(cuid())
  tenantId      String
  saleId        String
  productId     String
  variantId     String?
  quantidade    Decimal @db.Decimal(12, 3)
  precoUnitario Decimal @db.Decimal(10, 2)
  desconto      Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(12, 2)

  // PERSONALIZADO: componentes escolhidos no PDV — guiam a baixa de estoque.
  selectedComponentIds String[] @default([])

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@index([productId])
  // Giro da listagem de /produtos: "quanto este produto vendeu" filtra por
  // tenant + produto. Só ([productId]) obriga a reler linha a linha para
  // conferir o tenant.
  @@index([tenantId, productId])
}

model Payment {
  id         String        @id @default(cuid())
  tenantId   String
  saleId     String
  metodo     PaymentMethod
  status     PaymentStatus @default(CONFIRMADO)
  valor      Decimal       @db.Decimal(12, 2)
  troco      Decimal?      @db.Decimal(10, 2) // dinheiro
  gateway    String? // slug do provedor (MERCADO_PAGO, SIMULADO) — null = manual
  externalId String? // id da cobrança/intenção no provedor (webhook faz lookup)

  // PIX dinâmico — preenchidos ao criar a cobrança no provedor
  pixCopiaECola String?   @db.Text
  pixQrCode     String?   @db.Text // imagem base64 (png) retornada pelo provedor
  expiraEm      DateTime?

  // Cartão integrado — terminal que recebeu a intenção de pagamento
  terminalId String?

  // Cartão — devolvidos pelo PSP na APROVAÇÃO, nunca digitados pelo operador.
  // Bandeira é dado do adquirente: perguntar ao caixa gera erro e atraso, e o
  // que ele digita não vale nada perante a SEFAZ. Alimentam o grupo `card` da
  // NFC-e (YA04a) e a conciliação com o extrato do PSP.
  bandeira       String? // normalizada: VISA, MASTERCARD, ELO, AMEX, HIPERCARD, …
  parcelas       Int?
  nsu            String? // número sequencial único do adquirente
  autorizacao    String? // authorization_code → cAut da NFC-e
  adquirenteCnpj String? // credenciadora → card.CNPJ da NFC-e
  // Id da TRANSAÇÃO no PSP. Diferente de externalId (que é a intenção/pedido
  // enviada à maquininha) — o estorno e a conciliação precisam deste.
  pspPaymentId   String?

  // Comprovante do cartão (via cliente) devolvido pelo TEF/pinpad, texto pronto
  // para reimpressão. Separado do cupom fiscal (DANFCE), que vem do provedor.
  comprovante String? @db.Text

  createdAt DateTime @default(now())

  sale     Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  terminal PaymentTerminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([saleId])
  @@index([status])
  @@index([externalId])
}

// ── Pagamento integrado (Payment Service) ──────────────────
// Config por tenant: qual provedor processa PIX dinâmico e maquininha.
// Credenciais só no servidor — nunca expostas ao browser.
model PaymentProviderConfig {
  id       String              @id @default(cuid())
  tenantId String              @unique
  provider PaymentProviderKind
  ativo    Boolean             @default(true)

  accessToken   String // token privado do PSP (Mercado Pago: Access Token de produção; Stone: sk_ Pagar.me)
  webhookSecret String? // assinatura de webhook (Mercado Pago: secret do painel; Stone: Basic Auth "usuario:senha")
  partnerRef    String? // Stone Connect: ServiceRefererName (código do Programa de Parcerias) — exigido p/ cartão no POS
  ambiente      PaymentAmbiente @default(PRODUCAO) // PagBank: produção x sandbox — hosts de API diferentes

  pixAutomatico   Boolean @default(true) // PIX gera QR dinâmico e confirma sozinho
  cartaoIntegrado Boolean @default(false) // envia valor à maquininha via API

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Maquininha vinculada a um site/caixa (Mercado Pago Point: device_id).
model PaymentTerminal {
  id         String              @id @default(cuid())
  tenantId   String
  siteId     String
  nome       String // "Point Caixa 01"
  provider   PaymentProviderKind
  externalId String // device_id no provedor
  ativo      Boolean             @default(true)
  createdAt  DateTime            @default(now())

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([siteId])
}

model CashSession {
  id              String            @id @default(cuid())
  tenantId        String
  siteId          String
  operatorUserId  String
  status          CashSessionStatus @default(ABERTA)
  valorAbertura   Decimal           @db.Decimal(12, 2)
  valorFechamento Decimal?          @db.Decimal(12, 2) // contado no fechamento
  abertaEm        DateTime          @default(now())
  fechadaEm       DateTime?

  site      Site           @relation(fields: [siteId], references: [id])
  sales     Sale[]
  movements CashMovement[]

  @@index([tenantId])
  @@index([siteId])
  @@index([status])
}

model CashMovement {
  id            String           @id @default(cuid())
  tenantId      String
  cashSessionId String
  tipo          CashMovementType
  valor         Decimal          @db.Decimal(12, 2)
  motivo        String?
  createdAt     DateTime         @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([cashSessionId])
}

// Métodos de pagamento aceitos por site (defaults vêm do preset de atendimento)
model SitePaymentMethod {
  id       String        @id @default(cuid())
  tenantId String
  siteId   String
  metodo   PaymentMethod
  ativo    Boolean       @default(true)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, metodo])
  @@index([tenantId])
}

// ============================================================
// CRM / FIDELIZAÇÃO
// Cadastro leve do consumidor final para fidelização. Métricas (total gasto,
// ticket, visitas, produtos favoritos) NÃO ficam aqui — derivam de Sale/SaleItem
// via customerId, computadas ao vivo. `pontos` é o único saldo materializado.
// ============================================================

model Customer {
  id             String    @id @default(cuid())
  tenantId       String
  nome           String
  cpf            String? // só dígitos
  dataNascimento DateTime? @db.Date
  sexo           Sexo?
  whatsapp       String? // só dígitos (DDD + número)
  email          String?
  pontos         Int       @default(0)
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Fiscal — exigido só na NF-e (modelo 55). Na NFC-e o CPF basta, e mesmo
  // ele é opcional ("consumidor não identificado").
  cnpj            String? // só dígitos — cliente PJ
  razaoSocial     String?
  ie              String?
  indicadorIE     IndicadorIE?
  cep             String?
  logradouro      String?
  numero          String?
  complemento     String?
  bairro          String?
  municipio       String?
  codigoMunicipio String? // IBGE (7 dígitos) — a NF-e pede o código, não o nome
  uf              String?

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales              Sale[]
  coupons            CouponSend[]
  comodatoLoans      ComodatoLoan[]
  containerMovements ContainerMovement[]
  fiscalDocuments    FiscalDocument[]
  titulos            AccountReceivable[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@index([tenantId, nome])
}

// Registro de cupom enviado (risco/aniversário/manual). Serve de trava para não
// reenviar o mesmo tipo em janela curta e de histórico do disparo (WhatsApp).
model CouponSend {
  id         String       @id @default(cuid())
  tenantId   String
  customerId String
  motivo     CouponReason
  automatico Boolean      @default(false)
  mensagem   String?
  createdAt  DateTime     @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([createdAt])
}

// ============================================================
// COMODATO
// Ativos emprestados a clientes. Dois sabores:
// (1) ComodatoAsset: equipamento serializado (chopeira, freezer, cilindro) com
//     ciclo empréstimo→devolução via ComodatoLoan (aberto = devolvidoEm null).
// (2) ContainerType + ContainerMovement: vasilhames retornáveis por quantidade
//     (cascos/barris) — razão ASSINADO por cliente; saldo = Σ quantidade.
// ============================================================

model ComodatoAsset {
  id            String              @id @default(cuid())
  tenantId      String
  nome          String // ex.: "Chopeira 2 vias"
  identificacao String // serial / nº de patrimônio
  status        ComodatoAssetStatus @default(DISPONIVEL)
  valorEstimado Decimal?            @db.Decimal(10, 2) // valor de reposição
  observacao    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans  ComodatoLoan[]

  @@unique([tenantId, identificacao])
  @@index([tenantId])
  @@index([tenantId, status])
}

// Empréstimo de UM equipamento a UM cliente. Aberto = devolvidoEm null.
// Invariante (garantida nas actions): no máximo 1 loan aberto por asset.
model ComodatoLoan {
  id                String    @id @default(cuid())
  tenantId          String
  assetId           String
  customerId        String
  emprestadoEm      DateTime  @default(now())
  previsaoDevolucao DateTime? @db.Date
  devolvidoEm       DateTime?
  condicaoSaida     String? // estado do equipamento na entrega
  condicaoRetorno   String? // estado na devolução
  observacao        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  asset    ComodatoAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, devolvidoEm])
  @@index([assetId])
  @@index([customerId])
}

// Tipo de vasilhame retornável controlado por quantidade (casco, barril 30L…).
model ContainerType {
  id            String   @id @default(cuid())
  tenantId      String
  nome          String
  valorUnitario Decimal? @db.Decimal(10, 2) // valor de reposição unitário
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements ContainerMovement[]

  @@unique([tenantId, nome])
  @@index([tenantId])
}

// Razão assinado: quantidade guardada JÁ com sinal (ENTREGA > 0, DEVOLUCAO < 0,
// AJUSTE +/-). Saldo do cliente = SUM(quantidade) por (customer × type).
model ContainerMovement {
  id              String                @id @default(cuid())
  tenantId        String
  containerTypeId String
  customerId      String
  tipo            ContainerMovementType
  quantidade      Int // assinada
  observacao      String?
  createdAt       DateTime              @default(now())

  containerType ContainerType @relation(fields: [containerTypeId], references: [id], onDelete: Restrict)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([containerTypeId])
  @@index([customerId])
}

// ============================================================
// ANALYTICS (Fase 7)
// StockSnapshot: foto diária do saldo/valor por (produto × site). Capturado por
// job diário (idempotente por dia). Necessário PROSPECTIVAMENTE — giro e valor
// histórico de estoque não se reconstroem barato a partir do razão.
// productId/siteId são escalares (alto volume; alinhado a StockMovement).
// ============================================================

model StockSnapshot {
  id        String   @id @default(cuid())
  tenantId  String
  siteId    String
  productId String
  data      DateTime @db.Date

  saldoFechado Decimal  @db.Decimal(12, 3)
  saldoAberto  Decimal  @db.Decimal(12, 3)
  custoMedio   Decimal? @db.Decimal(10, 2)
  valorEstoque Decimal? @db.Decimal(14, 2) // (fechado + aberto convertido) × custoMedio

  createdAt DateTime @default(now())

  @@unique([siteId, productId, data])
  @@index([tenantId])
  @@index([siteId, data])
  @@index([data])
}

// ── Feedback dos insights do dashboard (/inicio) ────────────────
// Alimenta a repriorização por aprendizado: regras muito ignoradas descem
// de prioridade nos cards seguintes. `insightId` é a CHAVE DA REGRA (ex.:
// "ticket", "produto-crescimento"), não o id de uma instância — várias
// linhas por regra ao longo do tempo formam o histórico.

enum InsightFeedbackAcao {
  IGNORADO
  CLICADO
}

model InsightFeedback {
  id        String              @id @default(cuid())
  tenantId  String
  insightId String
  acao      InsightFeedbackAcao
  createdAt DateTime            @default(now())

  @@index([tenantId, insightId])
  @@index([tenantId, createdAt])
}

// Personalização do Centro de Operações (/inicio) — por usuário, por tenant.
// `hidden` = ids de widget ocultados; `ordem` = ids na ordem escolhida (widgets
// fora da lista entram no fim, na ordem default — ver inicio/_widgets.ts).
model DashboardWidgetPref {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  hidden    String[] @default([])
  ordem     String[] @default([])
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
}

// ============================================================
// FISCAL — emissão de documentos eletrônicos e entrada de XML.
//
// PRINCÍPIO: o NoHub não apura imposto nem gera SPED. Ele monta o documento,
// delega assinatura/transmissão ao provedor (FiscalProvider) e guarda o
// resultado. A legislação fica encapsulada no provedor.
//
// EMISSÃO É ASSÍNCRONA. A venda NUNCA espera a SEFAZ: fecha o caixa, cria o
// FiscalDocument em PENDENTE e um worker transmite. SEFAZ fora do ar não pode
// parar a loja — é também o que viabiliza contingência.
//
// O certificado A1 NÃO mora aqui: sobe uma vez para o provedor, que o guarda
// por CNPJ. Guardamos só o id opaco, o titular e a validade (para avisar do
// vencimento). Sem chave privada no nosso banco.
// ============================================================

enum FiscalProviderKind {
  NUVEM_FISCAL
  PLUGNOTAS
  FOCUS
  TECNOSPEED
  SIMULADO // desenvolvimento/demonstração, sem certificado nem SEFAZ
}

enum FiscalAmbiente {
  PRODUCAO // tpAmb 1
  HOMOLOGACAO // tpAmb 2
}

enum FiscalModelo {
  NFCE // modelo 65 — venda ao consumidor no PDV
  NFE // modelo 55 — pedido faturado, entrada, devolução
}

enum FiscalDirecao {
  SAIDA
  ENTRADA
}

enum FiscalStatus {
  PENDENTE // na fila, ainda não transmitido
  PROCESSANDO // enviado ao provedor, aguardando retorno da SEFAZ
  AUTORIZADO
  REJEITADO // erro de validação — corrigir e reemitir
  DENEGADO // SEFAZ negou por irregularidade do destinatário (não reemitir)
  CANCELADO
  CONTINGENCIA // emitido offline, pendente de transmissão
  INUTILIZADO // faixa de numeração queimada
}

enum FiscalEventoTipo {
  EMISSAO
  CANCELAMENTO
  CARTA_CORRECAO
  INUTILIZACAO
  REJEICAO
  CONTINGENCIA
  MANIFESTACAO
}

enum FiscalInboundStatus {
  PENDENTE // XML importado, itens ainda não relacionados a produtos
  CONCILIADO // todos os itens têm produto — pronto para gerar entrada
  RECEBIDO // entrada gerada (Purchase criada, estoque movimentado)
  DESCARTADO // nota que não vira entrada (já lançada, devolvida, erro)
  SEM_ESTOQUE // documento sem mercadoria (CT-e de frete, nota de serviço)
  VINCULADO // documenta entrada já lançada à mão — não movimenta de novo
}

enum ManifestacaoTipo {
  CIENCIA
  CONFIRMACAO
  DESCONHECIMENTO
  NAO_REALIZADA
}

/**
 * CRT do emitente. Define se o item sai com CSOSN (Simples) ou CST (Normal).
 */
enum RegimeTributario {
  SIMPLES_NACIONAL // CRT 1
  SIMPLES_EXCESSO // CRT 2
  REGIME_NORMAL // CRT 3
}

/**
 * indIEDest do destinatário.
 */
enum IndicadorIE {
  CONTRIBUINTE // 1
  ISENTO // 2
  NAO_CONTRIBUINTE // 9
}

// Credenciais do provedor fiscal — uma por tenant. O certificado é por CNPJ
// (ver FiscalEmitente); aqui fica só o acesso à API e o comportamento padrão.
model FiscalConfig {
  id       String             @id @default(cuid())
  tenantId String             @unique
  provider FiscalProviderKind @default(SIMULADO)
  ambiente FiscalAmbiente     @default(HOMOLOGACAO)
  ativo    Boolean            @default(false)

  apiToken      String? // token privado do provedor — nunca vai ao browser
  webhookSecret String? // valida o callback de autorização

  // Emitir NFC-e automaticamente ao confirmar o pagamento no PDV. Desligado
  // por padrão: muitos mercadinhos operam sem obrigação de emissão.
  emissaoAutomaticaNfce Boolean @default(false)

  // Minutos após a autorização em que a SEFAZ ainda aceita cancelamento de
  // NFC-e. Varia por UF (30 na maioria) — a UI usa isso para não oferecer um
  // botão que vai falhar.
  prazoCancelamentoMin Int @default(30)

  // Dá ciência automática nas notas que a SEFAZ mostra, liberando o XML
  // completo sem clique. Só CIÊNCIA (não confirma recebimento de mercadoria) e
  // só de fornecedor já cadastrado. Desligado por padrão: manifestação não tem
  // desfazer na SEFAZ.
  manifestacaoAutomatica Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Estabelecimento emitente — um por loja (Site). Multiempresa sai de graça:
// cada loja pode ter CNPJ, IE e certificado próprios. Loja sem emitente
// simplesmente não emite.
model FiscalEmitente {
  id       String @id @default(cuid())
  tenantId String
  siteId   String @unique

  cnpj         String // só dígitos
  razaoSocial  String
  nomeFantasia String?
  ie           String
  im           String? // inscrição municipal (serviços)
  cnae         String?
  regime       RegimeTributario @default(SIMPLES_NACIONAL)

  cep             String
  logradouro      String
  numero          String
  complemento     String?
  bairro          String
  municipio       String
  codigoMunicipio String // IBGE (7 dígitos)
  uf              String
  telefone        String?

  // Certificado A1 — armazenado NO PROVEDOR. Aqui só o rastro.
  certificadoId       String? // id opaco devolvido pelo provedor
  certificadoTitular  String? // CN do certificado, para conferência visual
  certificadoValidade DateTime?

  // NFC-e (modelo 65): CSC/token vêm do portal da SEFAZ da UF.
  cscId String? // idToken (identificador do CSC)
  csc   String? // código de segurança do contribuinte

  naturezaOperacaoPadrao String @default("Venda de mercadoria")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([tenantId, cnpj])
  @@index([tenantId])
}

// Contador de numeração por (loja × modelo × série). O próximo número sai de
// um UPDATE … RETURNING atômico — nunca de max(numero)+1, que gera duplicidade
// sob concorrência e derruba a nota na SEFAZ.
model FiscalSerie {
  id            String       @id @default(cuid())
  tenantId      String
  siteId        String
  modelo        FiscalModelo
  serie         Int
  proximoNumero Int          @default(1)
  ativa         Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, modelo, serie])
  @@index([tenantId])
}

// Documento fiscal que nós emitimos. O XML/PDF fica em blob storage — aqui só
// a URL, a chave de 44 dígitos e o protocolo.
model FiscalDocument {
  id       String         @id @default(cuid())
  tenantId String
  siteId   String
  modelo   FiscalModelo
  direcao  FiscalDirecao  @default(SAIDA)
  status   FiscalStatus   @default(PENDENTE)
  ambiente FiscalAmbiente

  serie  Int
  numero Int

  chave      String? // 44 dígitos — só existe após montar o documento
  protocolo  String? // nProt da autorização
  externalId String? // id do documento no provedor

  // Chave de idempotência. Retry de rede não pode emitir a mesma nota duas
  // vezes — a unicidade por tenant é a trava.
  idempotencyKey String

  naturezaOperacao String
  dataEmissao      DateTime  @default(now())
  dataAutorizacao  DateTime?

  /// Chave da NF-e referenciada (refNFe). Devolução PRECISA apontar para a nota
  /// que trouxe a mercadoria — sem isso a SEFAZ aceita, mas o fisco cruza a
  /// entrada com a saída e não fecha.
  chaveReferenciada String?

  saleId     String?
  purchaseId String?
  customerId String?
  supplierId String?

  // Snapshot do destinatário no momento da emissão — o cadastro muda, a nota
  // não. Sem isso a segunda via mente.
  destNome      String?
  destDocumento String? // CPF/CNPJ, só dígitos

  valorProdutos Decimal @default(0) @db.Decimal(12, 2)
  valorDesconto Decimal @default(0) @db.Decimal(12, 2)
  valorTotal    Decimal @default(0) @db.Decimal(12, 2)

  codigoRejeicao String? // cStat da SEFAZ (ex.: "539")
  motivoRejeicao String? // xMotivo legível — vai direto para a tela
  tentativas     Int     @default(0)
  contingencia   Boolean @default(false)

  xmlUrl      String? // XML autorizado (blob privado)
  pdfUrl      String? // DANFE / DANFE-NFC-e
  qrCodeUrl   String? // NFC-e: URL do QR Code impressa no cupom
  urlConsulta String? // consulta pública na SEFAZ

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site      Site                 @relation(fields: [siteId], references: [id])
  sale      Sale?                @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase  Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  customer  Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier  Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items     FiscalDocumentItem[]
  eventos   FiscalEvent[]
  devolucao SupplierReturn?

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, chave])
  @@unique([siteId, modelo, serie, numero])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([siteId, dataEmissao])
  @@index([saleId])
  @@index([customerId])
  @@index([supplierId])
}

// Item da nota — SNAPSHOT completo. Nunca leia o produto para reimprimir uma
// nota: preço, NCM e alíquota do cadastro mudam; os da nota são imutáveis.
// productId é escalar (alto volume, igual a StockMovement).
model FiscalDocumentItem {
  id         String  @id @default(cuid())
  tenantId   String
  documentId String
  ordem      Int // nItem no XML (1-based)
  productId  String?

  codigo    String // cProd
  descricao String
  gtin      String? // cEAN
  ncm       String
  cest      String?
  cfop      String
  origem    String  @default("0")
  cst       String?
  csosn     String?

  unidade       String
  quantidade    Decimal @db.Decimal(12, 4)
  valorUnitario Decimal @db.Decimal(12, 4)
  valorTotal    Decimal @db.Decimal(12, 2)
  valorDesconto Decimal @default(0) @db.Decimal(12, 2)

  baseIcms     Decimal? @db.Decimal(12, 2)
  aliquotaIcms Decimal? @db.Decimal(5, 2)
  valorIcms    Decimal? @db.Decimal(12, 2)
  valorIcmsSt  Decimal? @db.Decimal(12, 2)
  valorPis     Decimal? @db.Decimal(12, 2)
  valorCofins  Decimal? @db.Decimal(12, 2)

  document FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordem])
  @@index([tenantId])
  @@index([documentId])
  @@index([productId])
}

// Trilha append-only: emissão, cancelamento, CC-e, inutilização, rejeição,
// contingência, manifestação. É histórico fiscal E auditoria — nunca atualize
// nem apague uma linha daqui.
model FiscalEvent {
  id         String           @id @default(cuid())
  tenantId   String
  documentId String? // inutilização não tem documento
  tipo       FiscalEventoTipo

  sequencia Int? // nSeqEvento (CC-e permite até 20)
  motivo    String? // justificativa (mín. 15 caracteres na SEFAZ)
  protocolo String?
  codigo    String? // cStat do retorno
  mensagem  String? // xMotivo

  // Inutilização de faixa (sem documento associado).
  serie         Int?
  numeroInicial Int?
  numeroFinal   Int?

  payload   Json? // retorno bruto do provedor — ouro no suporte
  userId    String?
  createdAt DateTime @default(now())

  document FiscalDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([documentId])
}

// Nota de FORNECEDOR (XML de entrada). Caminho:
// XML → relacionar itens a produtos → gerar Purchase → estoque + custo médio.
model FiscalInbound {
  id       String              @id @default(cuid())
  tenantId String
  siteId   String // loja onde a mercadoria entra
  status   FiscalInboundStatus @default(PENDENTE)

  chave         String // 44 dígitos — trava contra importar a mesma nota duas vezes
  modelo        String   @default("55")
  numero        Int
  serie         Int
  dataEmissao   DateTime
  valorTotal    Decimal  @db.Decimal(12, 2)
  valorFrete    Decimal  @default(0) @db.Decimal(12, 2) // vFrete do total da nota
  valorDesconto Decimal  @default(0) @db.Decimal(12, 2) // vDesc do total da nota

  // Emitente do XML, guardado cru: o Supplier pode ainda não existir no
  // cadastro, e a importação não pode travar por causa disso.
  emitCnpj        String
  emitRazaoSocial String
  emitUf          String?
  supplierId      String?

  purchaseOrderId String? // pedido de compra conciliado
  purchaseId      String? @unique // entrada gerada

  // Conciliação com o pedido: o vínculo foi sugerido pelo sistema (CNPJ + xPed
  // + itens) ou escolhido à mão? `scoreVinculo` fica guardado para auditar por
  // que aquele pedido foi escolhido sozinho.
  vinculoAutomatico Boolean   @default(false)
  scoreVinculo      Int?
  conciliadoEm      DateTime?

  manifestacao  ManifestacaoTipo?
  manifestadoEm DateTime?

  // Documento que não movimenta estoque (CT-e, nota de serviço) ou nota que só
  // documentou uma entrada já lançada à mão. Guardar o porquê evita que a
  // próxima pessoa reimporte achando que a nota "sumiu".
  semEstoqueMotivo String?

  /// Frete que chegou em CT-e separado e foi rateado para esta nota. Entra no
  /// custo junto com o `valorFrete` da própria NF-e — a mercadoria custa o que
  /// custou para chegar, esteja o frete em um documento ou em dois.
  ///
  /// `freteCteRateadoEm` nulo com valor > 0 = o CT-e chegou DEPOIS da entrada:
  /// o valor fica registrado mas não entra no custo médio, porque reprocessar
  /// razão fechada é pior do que mostrar a diferença.
  freteCteValor     Decimal   @default(0) @db.Decimal(12, 2)
  freteCteChave     String?
  freteCteRateadoEm DateTime?

  xmlUrl       String?
  observacao   String?
  importadoPor String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site          Site                         @relation(fields: [siteId], references: [id])
  supplier      Supplier?                    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?               @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  purchase      Purchase?                    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  items         FiscalInboundItem[]
  xmlArquivo    FiscalInboundXml?
  duplicatas    FiscalInboundDuplicata[]
  conciliacao   PurchaseReconciliationItem[]
  eventos       PurchaseEvent[]
  titulos       AccountPayable[]
  devolucoes    SupplierReturn[]

  @@unique([tenantId, chave])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([siteId])
  @@index([supplierId])
}

// Item do XML do fornecedor + o produto ao qual foi relacionado. Enquanto
// houver item com productId null a nota fica PENDENTE.
model FiscalInboundItem {
  id        String @id @default(cuid())
  tenantId  String
  inboundId String
  ordem     Int

  // Como veio no XML.
  codigoFornecedor     String // cProd
  gtin                 String? // cEAN
  descricao            String
  ncm                  String?
  cest                 String? // só em produto sujeito a ST
  cfop                 String?
  unidade              String // uCom — como o fornecedor vende (cx, fardo, display)
  quantidade           Decimal  @db.Decimal(12, 4)
  // uTrib/qTrib — unidade tributável. Guardados como vieram: é a prova de
  // quantas unidades de prateleira o fornecedor diz que há em cada caixa.
  unidadeTributavel    String?
  quantidadeTributavel Decimal? @db.Decimal(12, 4)
  valorUnitario        Decimal  @db.Decimal(12, 4)
  valorTotal           Decimal  @db.Decimal(12, 2)
  valorDesconto        Decimal  @default(0) @db.Decimal(12, 2)
  valorIcmsSt          Decimal  @default(0) @db.Decimal(12, 2)
  valorFcpSt           Decimal  @default(0) @db.Decimal(12, 2) // FCP retido por ST
  valorIpi             Decimal  @default(0) @db.Decimal(12, 2)
  valorFrete           Decimal  @default(0) @db.Decimal(12, 2)

  // xPed/nItemPed — número do pedido do comprador que o fornecedor digitou na
  // nota. Quando vem preenchido, é a pista mais forte de qual pedido do NoHub
  // esta nota fatura.
  pedidoFornecedor String?
  itemPedidoNumero Int?

  // Resolução no nosso catálogo.
  productId      String?
  packagingId    String? // fornecedor manda caixa, estoque conta unidade
  // Unidades do nosso estoque por unidade do XML (caixa com 12 → 12).
  fatorConversao Decimal @default(1) @db.Decimal(12, 4)
  bonificacao    Boolean @default(false) // CFOP de bonificação: entra sem custo

  inbound     FiscalInbound                @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  conciliacao PurchaseReconciliationItem[]

  @@unique([inboundId, ordem])
  @@index([tenantId])
  @@index([inboundId])
  @@index([productId])
}

// ============================================================
// RECEBIMENTO INTELIGENTE — conciliação em três camadas
//
//   Pedido NoHub      → o que eu comprei
//   XML da NF-e       → o que o fornecedor faturou
//   Conferência física→ o que realmente entrou
//
// O estoque só se move na terceira camada. As duas primeiras existem para que
// a terceira seja quase só confirmar: o operador confere mercadoria, não digita
// nota. Tudo o que a conciliação decidiu fica gravado — inclusive o XML cru,
// que é a prova do que o fornecedor cobrou.
// ============================================================

/// XML original da nota, guardado inteiro. Fica em tabela separada de propósito:
/// é um texto grande que nenhuma listagem precisa carregar.
model FiscalInboundXml {
  id          String   @id @default(cuid())
  tenantId    String
  inboundId   String   @unique
  nomeArquivo String
  conteudo    String // XML cru, como chegou
  createdAt   DateTime @default(now())

  inbound FiscalInbound @relation(fields: [inboundId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Veredito da linha na conciliação pedido × nota.
enum ReconciliationStatus {
  OK // quantidade e custo batem
  FALTANDO // faturado a menos que o pedido
  EXCEDENTE // faturado a mais que o pedido
  NAO_FATURADO // está no pedido, não veio na nota
  NAO_PEDIDO // veio na nota, não estava no pedido
  PRECO_ALTERADO // quantidade bate, custo mudou
}

/// O que o operador decidiu sobre a divergência.
enum ReconciliationResolucao {
  ACEITO // segue como a nota diz (inclusive o custo novo)
  IGNORADO // divergência conhecida, não trava o recebimento
  AJUSTADO // operador corrigiu a quantidade na conferência
}

/// Uma linha da conciliação. Existe mesmo sem par dos dois lados: item do
/// pedido que não veio na nota e item da nota fora do pedido também viram
/// linha — é justamente isso que o painel de divergências mostra.
///
/// Quantidades e custos ficam em UNIDADE BASE do estoque. O pedido fala em
/// caixa, a nota fala em fardo; comparar sem converter é o erro clássico que
/// faz "10 caixas" parecer divergência de "120 unidades".
model PurchaseReconciliationItem {
  id                  String  @id @default(cuid())
  tenantId            String
  inboundId           String
  purchaseOrderId     String
  purchaseOrderItemId String?
  inboundItemId       String?

  productId        String?
  codigoFornecedor String?
  ean              String?
  descricao        String // o nome que aparece na tela (nosso produto ou o xProd)

  qtdPedida     Decimal  @default(0) @db.Decimal(12, 3)
  qtdFaturada   Decimal  @default(0) @db.Decimal(12, 3)
  qtdRecebida   Decimal? @db.Decimal(12, 3) // null = ainda não conferido
  custoPedido   Decimal  @default(0) @db.Decimal(12, 4)
  custoFaturado Decimal  @default(0) @db.Decimal(12, 4)
  bonificacao   Boolean  @default(false)

  status            ReconciliationStatus
  resolucao         ReconciliationResolucao?
  motivoDivergencia String?

  // Conferência física: o único dado que só existe na porta.
  lote     String?
  validade DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inbound       FiscalInbound      @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  orderItem     PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  inboundItem   FiscalInboundItem? @relation(fields: [inboundItemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([inboundId])
  @@index([purchaseOrderId])
  @@index([productId])
}

/// Marcos do pedido de compra — a timeline. Cada transição vira uma linha;
/// nada aqui é derivado de status, porque status só guarda o "agora".
enum PurchaseEventType {
  PEDIDO_CRIADO
  PEDIDO_ENVIADO
  PEDIDO_CONFIRMADO
  PEDIDO_EM_TRANSITO
  XML_RECEBIDO
  CONCILIACAO_CONCLUIDA
  VINCULO_ALTERADO
  DIVERGENCIA_RESOLVIDA
  CUSTO_ACEITO
  CONFERENCIA_CONCLUIDA
  ESTOQUE_ATUALIZADO
  PEDIDO_CANCELADO
  SALDO_ENCERRADO // o que faltou não vem mais
  SALDO_REPEDIDO // o saldo virou pedido novo
  TITULOS_GERADOS // contas a pagar emitidas
  DEVOLUCAO_REGISTRADA // mercadoria voltou ao fornecedor
  DOCUMENTO_VINCULADO // XML documentou uma entrada já lançada à mão
}

model PurchaseEvent {
  id              String            @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  inboundId       String?
  tipo            PurchaseEventType
  descricao       String
  meta            Json? // detalhe da linha (item, quantidades, custos)
  createdAt       DateTime          @default(now())
  createdBy       String?

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inbound       FiscalInbound? @relation(fields: [inboundId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([purchaseOrderId, createdAt])
}

// De-para persistido fornecedor↔catálogo. Escrito quando o operador relaciona
// um item na primeira nota; da segunda em diante a importação resolve sozinha.
// É o que faz a entrada por XML valer a pena no dia a dia.
model SupplierItemMap {
  id               String  @id @default(cuid())
  tenantId         String
  supplierId       String
  codigoFornecedor String // cProd do XML
  gtin             String?
  productId        String
  packagingId      String?
  fatorConversao   Decimal @default(1) @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, codigoFornecedor])
  @@index([tenantId])
  @@index([productId])
}

// ============================================================
// ENTRADA DE NF-e — canais de importação e trilha de auditoria
//
// O XML chega por três portas (upload, e-mail do fornecedor, distribuição da
// SEFAZ) e todas terminam no mesmo `importarNotasXml`. O que muda é só quem
// trouxe o arquivo — e é isso que estas tabelas guardam: a caixa de e-mail
// monitorada, a mensagem já processada (para não importar duas vezes) e o log
// do que entrou, foi ignorado ou falhou.
// ============================================================

/// Porta de entrada do XML. Serve à auditoria ("de onde veio esta nota?") e a
/// medir quanto da operação já é automática.
enum FiscalImportOrigem {
  UPLOAD // arquivo enviado à mão na tela
  EMAIL // anexo capturado na caixa monitorada
  SEFAZ // distribuição DF-e com certificado A1
}

enum FiscalImportStatus {
  IMPORTADA
  DUPLICADA // a chave já existia — trava proposital, não é erro
  IGNORADA // arquivo sem NF-e (PDF, boleto, assinatura de e-mail)
  ERRO
}

/// Caixa de e-mail monitorada. Uma por conta; o fornecedor manda o XML e o job
/// varre a pasta. A senha é de aplicativo (Gmail exige) e fica cifrada —
/// vazamento de dump não pode entregar a caixa de entrada do lojista.
model FiscalEmailInbox {
  id       String @id @default(cuid())
  tenantId String
  siteId   String // loja onde a mercadoria desta caixa entra

  nome    String // "Compras — matriz"
  email   String
  host    String
  porta   Int     @default(993)
  ssl     Boolean @default(true)
  usuario String
  senha   String  @default("") // cifrada (lib/crypto) — vazia quando a conta usa OAuth
  pasta   String  @default("INBOX")
  ativo   Boolean @default(true)

  // Google e Microsoft estão desligando senha de aplicativo no IMAP. OAuth2
  // guarda o refresh token (cifrado) e troca por access token a cada varredura
  // — o app do cliente, não um app do NoHub: quem responde pela caixa é ele.
  autenticacao      FiscalEmailAuth @default(SENHA)
  oauthClientId     String?
  oauthClientSecret String? // cifrado
  oauthRefreshToken String? // cifrado
  oauthTenantId     String? // Microsoft: "common" ou o id do diretório

  // Só diagnóstico da última varredura: a tela precisa dizer se a automação
  // está viva sem obrigar o operador a abrir log.
  ultimaSincronizacao DateTime?
  ultimoErro          String?
  mensagensLidas      Int       @default(0) // diagnóstico: total já processado

  // Trava de varredura: dois workers na mesma caixa baixam o mesmo anexo duas
  // vezes. Guardado com hora para destravar sozinho se o processo morrer.
  sincronizandoEm DateTime?

  // Backoff: caixa com senha revogada seria reconectada a cada 20 min para
  // sempre — é assim que o provedor bloqueia o IP.
  falhasSeguidas   Int       @default(0)
  proximaTentativa DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site      Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  mensagens FiscalEmailMessage[]
  logs      FiscalImportLog[]

  @@unique([tenantId, email, pasta])
  @@index([tenantId])
  @@index([siteId])
}

/// Como a caixa se autentica. Senha de aplicativo ainda funciona no Gmail; o
/// Microsoft 365 já desligou autenticação básica em boa parte dos tenants.
enum FiscalEmailAuth {
  SENHA
  OAUTH2_GOOGLE
  OAUTH2_MICROSOFT
}

/// Duplicatas (cobr/dup) da NF-e: o parcelamento que o fornecedor cobrou.
/// Guardadas na importação porque o XML é a única fonte — quando o financeiro
/// existir, contas a pagar nasce daqui sem reprocessar nota velha.
model FiscalInboundDuplicata {
  id         String   @id @default(cuid())
  tenantId   String
  inboundId  String
  numero     String // nDup — "001", "002"
  vencimento DateTime
  valor      Decimal  @db.Decimal(12, 2)

  inbound FiscalInbound @relation(fields: [inboundId], references: [id], onDelete: Cascade)

  @@unique([inboundId, numero])
  @@index([tenantId])
  @@index([tenantId, vencimento])
}

/// Mensagem já processada. Existe para a idempotência não depender da flag
/// \Seen do IMAP: o operador abre o e-mail no celular e a caixa toda voltaria
/// a ser reprocessada.
model FiscalEmailMessage {
  id        String @id @default(cuid())
  tenantId  String
  inboxId   String
  uid       Int
  messageId String // Message-ID do cabeçalho; sem ele, "uid:<n>"

  assunto      String?
  remetente    String?
  recebidoEm   DateTime?
  anexos       Int       @default(0)
  importados   Int       @default(0)
  processadoEm DateTime  @default(now())

  inbox FiscalEmailInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@unique([inboxId, messageId])
  @@index([tenantId])
  @@index([inboxId, uid])
}

/// Trilha de importação — uma linha por arquivo visto, em qualquer canal.
/// Duplicada e ignorada também entram: a pergunta que a tela responde é "por
/// que esta nota não apareceu?", e silêncio nunca responde isso.
model FiscalImportLog {
  id       String             @id @default(cuid())
  tenantId String
  siteId   String?
  origem   FiscalImportOrigem
  status   FiscalImportStatus

  arquivo   String?
  chave     String?
  mensagem  String?
  remetente String? // quem mandou o e-mail
  inboxId   String?
  inboundId String? // nota gerada, quando houve

  usuarioId    String?
  processadoEm DateTime @default(now())

  inbox FiscalEmailInbox? @relation(fields: [inboxId], references: [id], onDelete: SetNull)

  @@index([tenantId, processadoEm])
  @@index([tenantId, chave])
  @@index([inboxId])
}

// ============================================================
// COMPRAS COM FORNECEDORES — catálogo, oferta e comparação
//
// O fornecedor manda tabela de mil jeitos (planilha, PDF no WhatsApp, foto,
// XML, API). O módulo aceita todos e converte para UM formato interno
// (`OfertaNormalizada`, src/lib/compras-fornecedores/types.ts). Daí para
// frente — comparador, cesta, carrinho, histórico — nada mais sabe de onde o
// dado veio: conector novo entra sem tocar no resto.
//
// Produto NÃO é duplicado: o item do catálogo aponta para o Product do tenant
// (`productId`). Sem correspondência, ele fica com matchStatus=PENDENTE e cai
// na fila de revisão manual — a oferta continua visível, só não entra na
// comparação por produto.
// ============================================================

/// Como a tabela do fornecedor chega. Cada valor tem um conector
/// (src/lib/compras-fornecedores/connectors) que devolve o mesmo formato.
enum SupplierIntegrationKind {
  API
  PLANILHA // .xlsx
  CSV
  PDF
  IMAGEM
  XML
  JSON
  MANUAL // digitado na tela
}

enum SupplierIntegrationStatus {
  NAO_CONFIGURADA
  ONLINE
  OFFLINE
  ERRO
}

enum SupplierImportStatus {
  PENDENTE
  PROCESSANDO
  CONCLUIDA
  CONCLUIDA_COM_ERROS
  FALHOU
}

/// Estado do vínculo item do fornecedor → produto do tenant.
enum SupplierMatchStatus {
  VINCULADO
  PENDENTE // fila de revisão manual
  IGNORADO // "não vendo isso" — some da fila sem virar produto
}

/// Por onde o vínculo foi feito — vira confiança na tela de revisão.
enum SupplierMatchOrigem {
  EAN
  CODIGO_FORNECEDOR
  SKU
  NOME
  MANUAL
}

/// Configuração do conector de um fornecedor (1–1). Credencial vive cifrada
/// (lib/crypto.ts) e nunca sai do servidor.
model SupplierIntegration {
  id         String                  @id @default(cuid())
  tenantId   String
  supplierId String                  @unique
  kind       SupplierIntegrationKind @default(MANUAL)
  ativo      Boolean                 @default(true)

  // API
  endpoint   String?
  authTipo   String? // "bearer" | "basic" | "apikey" | "none"
  usuario    String? // parte pública do Basic — a senha vive cifrada em `credencial`
  credencial String? // cifrada
  headers    Json? // cabeçalhos extras

  /// Mapa coluna do arquivo → campo interno. Nulo = detecção automática.
  mapeamento Json?

  /// Sincronização automática (só quando aceitaImportacaoAutomatica).
  frequenciaHoras Int?
  proximaSync     DateTime?
  ultimaSync      DateTime?
  ultimoErro      String?

  status SupplierIntegrationStatus @default(NAO_CONFIGURADA)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, proximaSync])
}

/// Uma tabela de preços do fornecedor. O caso comum é uma só ("Tabela geral");
/// `referencia` existe para quem manda tabela por região/rede.
model SupplierCatalog {
  id         String                  @id @default(cuid())
  tenantId   String
  supplierId String
  nome       String                  @default("Tabela geral")
  referencia String                  @default("padrao")
  origem     SupplierIntegrationKind @default(MANUAL)
  ativo      Boolean                 @default(true)
  totalItens Int                     @default(0) // contagem cacheada (itens ativos)

  vigenciaInicio DateTime?
  vigenciaFim    DateTime?
  atualizadoEm   DateTime? // última ingestão bem-sucedida

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    SupplierCatalogItem[]
  imports  SupplierImport[]

  @@unique([supplierId, referencia])
  @@index([tenantId])
  @@index([supplierId])
}

/// Item do catálogo = a oferta VIGENTE daquele produto naquele fornecedor.
/// É a linha que o comparador lê — por isso o preço corrente mora aqui, e não
/// só em SupplierOffer (que guarda janelas futuras/escalonadas).
model SupplierCatalogItem {
  id         String @id @default(cuid())
  tenantId   String
  catalogId  String
  supplierId String

  /// Chave estável do item dentro do catálogo: código do fornecedor, senão
  /// EAN, senão a descrição normalizada. É o que evita item duplicado a cada
  /// reimportação da mesma tabela.
  chave            String
  codigoFornecedor String?
  ean              String?
  descricao        String
  marca            String?
  categoria        String?
  imagemUrl        String?
  unidade          String? // "UN", "CX 12", "FD 6"
  fatorConversao   Decimal @default(1) @db.Decimal(12, 4) // unidades do produto por unidade de compra

  preco             Decimal   @db.Decimal(12, 4)
  precoPromocional  Decimal?  @db.Decimal(12, 4)
  emPromocao        Boolean   @default(false)
  quantidadeMinima  Decimal?  @db.Decimal(12, 3)
  estoqueDisponivel Decimal?  @db.Decimal(12, 3)
  validadeOferta    DateTime?

  productId   String?
  matchStatus SupplierMatchStatus  @default(PENDENTE)
  matchOrigem SupplierMatchOrigem?

  ativo             Boolean  @default(true) // false = sumiu da última tabela do fornecedor
  ultimaAtualizacao DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  catalog  SupplierCatalog              @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  supplier Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product?                     @relation(fields: [productId], references: [id])
  offers   SupplierOffer[]
  history  SupplierPriceHistory[]
  cartRefs SupplierCartItem[]
  vinculos SupplierCatalogItemProduct[]

  @@unique([catalogId, chave])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, ean])
  @@index([tenantId, matchStatus])
  @@index([supplierId])
}

/// Vínculo item↔produto além do principal (SupplierCatalogItem.productId).
/// Item de encarte tipo "Baly 2L — todos os sabores" cobre vários produtos de
/// verdade: o principal é quem entra no carrinho/pedido; os demais só entram
/// na comparação de preço de cada produto. Automático (EAN/código) nunca
/// grava mais de uma linha aqui — multi-vínculo só nasce de revisão manual.
model SupplierCatalogItemProduct {
  id            String   @id @default(cuid())
  tenantId      String
  catalogItemId String
  productId     String
  principal     Boolean  @default(false)
  createdAt     DateTime @default(now())

  catalogItem SupplierCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([catalogItemId, productId])
  @@index([tenantId])
  @@index([productId])
  @@index([catalogItemId])
}

/// Oferta com janela de validade e/ou quantidade mínima escalonada. O item
/// carrega a oferta vigente; aqui ficam as promoções datadas — inclusive as
/// que ainda vão começar.
model SupplierOffer {
  id               String   @id @default(cuid())
  tenantId         String
  supplierId       String
  catalogItemId    String
  preco            Decimal  @db.Decimal(12, 4)
  precoPromocional Decimal? @db.Decimal(12, 4)
  quantidadeMinima Decimal? @db.Decimal(12, 3)

  inicio   DateTime  @default(now())
  fim      DateTime?
  ativa    Boolean   @default(true)
  importId String?

  createdAt DateTime @default(now())

  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  catalogItem SupplierCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([catalogItemId])
  @@index([tenantId, ativa, fim])
}

/// Série de preço — uma linha por MUDANÇA de preço (reimportar tabela igual
/// não polui o gráfico). É o que separa promoção de verdade de "preço de
/// sempre com etiqueta de promoção".
model SupplierPriceHistory {
  id               String   @id @default(cuid())
  tenantId         String
  supplierId       String
  catalogItemId    String
  productId        String?
  preco            Decimal  @db.Decimal(12, 4)
  precoPromocional Decimal? @db.Decimal(12, 4)
  emPromocao       Boolean  @default(false)
  data             DateTime @default(now())
  importId         String?

  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  catalogItem SupplierCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  product     Product?            @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([catalogItemId, data])
  @@index([tenantId, productId, data])
}

/// Registro de cada ingestão — arquivo, API ou digitação. Mantém o rastro de
/// quem subiu o quê e o que o conector entendeu.
model SupplierImport {
  id         String                  @id @default(cuid())
  tenantId   String
  supplierId String
  catalogId  String?
  tipo       SupplierIntegrationKind
  origem     String                  @default("manual") // manual | api | agendado

  arquivoNome    String?
  arquivoTamanho Int?
  mimeType       String?

  status SupplierImportStatus @default(PENDENTE)

  totalLinhas      Int @default(0)
  itensLidos       Int @default(0)
  itensNovos       Int @default(0)
  itensAtualizados Int @default(0)
  itensSemVinculo  Int @default(0)

  mensagem  String?
  erros     Json?
  createdBy String?

  createdAt   DateTime  @default(now())
  concluidoEm DateTime?

  supplier Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  catalog  SupplierCatalog? @relation(fields: [catalogId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([supplierId])
}

/// Carrinho de compras do módulo — por usuário. Vira um PurchaseOrder POR
/// FORNECEDOR no fechamento; nada aqui mexe em estoque.
model SupplierCartItem {
  id            String  @id @default(cuid())
  tenantId      String
  userId        String
  supplierId    String
  catalogItemId String?
  productId     String?
  descricao     String
  quantidade    Decimal @default(1) @db.Decimal(12, 3)
  precoUnitario Decimal @default(0) @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  catalogItem SupplierCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  product     Product?             @relation(fields: [productId], references: [id])

  @@index([tenantId, userId])
  @@index([supplierId])
}

// ─────────────────────────────────────────────────────────────
// Cotações (RFQ) — pedir preço antes de comprar
// ─────────────────────────────────────────────────────────────
// O operador monta uma lista de itens, escolhe os fornecedores, envia o
// pedido de cotação e registra as respostas. O comparativo mostra o melhor
// preço por item e a cotação vira um PurchaseOrder por fornecedor escolhido.
//
// Diferença para o Comparador: lá o preço já está na tabela que o fornecedor
// mandou; aqui o preço ainda não existe — é pergunta feita e resposta dada.

enum QuotationStatus {
  RASCUNHO // montando a lista, ninguém foi avisado
  ABERTA // enviada, aguardando respostas
  ENCERRADA // prazo vencido ou fechada à mão; ainda dá para decidir
  DECIDIDA // virou pedido de compra
  CANCELADA
}

enum QuotationSupplierStatus {
  PENDENTE // ainda não enviada a este fornecedor
  ENVIADA // pergunta feita, sem resposta
  RESPONDIDA // preços registrados
  RECUSADA // fornecedor não vai cotar
}

/// Quem digitou a resposta. Muda o que a Central de Respostas mostra: o que
/// veio pelo link já está no formato certo; o que o operador transcreveu de um
/// áudio ou de uma foto merece um segundo olhar.
/// Por onde o convite saiu. WhatsApp é mensagem pronta que o operador dispara
/// (não há gateway); e-mail sai do servidor.
enum QuotationCanal {
  WHATSAPP
  EMAIL
}

enum QuotationResponseOrigem {
  OPERADOR // alguém da loja registrou o que o fornecedor mandou
  LINK // o fornecedor preencheu o link público
}

model Quotation {
  id       String          @id @default(cuid())
  tenantId String
  siteId   String // para onde a mercadoria viria
  numero   String // COT-00042 (sequencial por tenant)
  titulo   String
  status   QuotationStatus @default(RASCUNHO)

  prazoResposta DateTime? // até quando o fornecedor pode responder
  observacao    String?

  enviadaEm   DateTime?
  encerradaEm DateTime?
  decididaEm  DateTime?
  canceladaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?

  site      Site                @relation(fields: [siteId], references: [id])
  items     QuotationItem[]
  suppliers QuotationSupplier[]
  pedidos   PurchaseOrder[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([siteId])
}

/// Linha da pergunta: o que se quer comprar e quanto. O produto é opcional —
/// dá para cotar algo que ainda não está no catálogo.
model QuotationItem {
  id          String  @id @default(cuid())
  tenantId    String
  quotationId String
  productId   String?
  packagingId String? // unidade de compra pedida (caixa, fardo…)
  descricao   String // o que o fornecedor lê
  quantidade  Decimal @default(1) @db.Decimal(12, 3)
  observacao  String?
  ordem       Int     @default(0)

  quotation Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  responses QuotationResponse[]

  @@index([tenantId])
  @@index([quotationId])
  @@index([productId])
}

/// Um convite por fornecedor. Guarda o que vale para a cotação inteira
/// (frete, prazo, condição de pagamento) — o preço por item mora na resposta.
model QuotationSupplier {
  id          String                  @id @default(cuid())
  tenantId    String
  quotationId String
  supplierId  String
  status      QuotationSupplierStatus @default(PENDENTE)

  /// Quem recebeu (ou vai receber) a cotação neste fornecedor. Nulo = ninguém
  /// cadastrado ainda; cai no telefone/e-mail da empresa.
  contactId String?

  enviadaEm    DateTime?
  respondidaEm DateTime?

  prazoEntregaDias  Int?
  condicaoPagamento String?
  frete             Decimal? @db.Decimal(12, 2)
  observacao        String? // recado do fornecedor ou motivo da recusa

  purchaseOrderId String? // pedido gerado quando esta cotação foi escolhida

  respondidaVia QuotationResponseOrigem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  contact   SupplierContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  responses QuotationResponse[]
  envios    QuotationSend[]
  link      QuotationLink?

  @@unique([quotationId, supplierId])
  @@index([tenantId])
  @@index([supplierId])
  @@index([contactId])
}

/// Uma linha por disparo: quem recebeu, por onde e quando. `enviadaEm` no
/// convite responde "já foi?"; isto responde "foi para quem, por qual canal e
/// quantas vezes" — que é o que o operador pergunta no reenvio ("mandei pro
/// João ou pra Maria?").
///
/// Os dados do contato ficam COPIADOS aqui: contato removido do cadastro não
/// pode apagar o histórico de que ele recebeu a cotação.
model QuotationSend {
  id                  String  @id @default(cuid())
  tenantId            String
  quotationSupplierId String
  contactId           String?

  canal       QuotationCanal
  contatoNome String? // cópia — sobrevive à exclusão do contato
  destino     String? // número ou e-mail de fato usado
  reenvio     Boolean        @default(false)
  /// E-mail que voltou com erro fica registrado como tentativa falha; WhatsApp
  /// sai como mensagem pronta e por isso conta sempre como enviado.
  sucesso     Boolean        @default(true)
  erro        String?
  enviadoEm   DateTime       @default(now())
  enviadoPor  String?

  quotationSupplier QuotationSupplier @relation(fields: [quotationSupplierId], references: [id], onDelete: Cascade)
  contact           SupplierContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([quotationSupplierId, enviadoEm])
}

/// A resposta de um fornecedor para um item. Sem linha = não respondeu;
/// `disponivel = false` = respondeu que não tem.
model QuotationResponse {
  id                  String @id @default(cuid())
  tenantId            String
  quotationSupplierId String
  quotationItemId     String

  disponivel         Boolean  @default(true)
  precoUnitario      Decimal  @default(0) @db.Decimal(12, 4)
  quantidadeOfertada Decimal? @db.Decimal(12, 3) // quando o fornecedor só atende parte
  marca              String? // "aceito similar" vira isto
  observacao         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotationSupplier QuotationSupplier @relation(fields: [quotationSupplierId], references: [id], onDelete: Cascade)
  quotationItem     QuotationItem     @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  @@unique([quotationSupplierId, quotationItemId])
  @@index([tenantId])
  @@index([quotationItemId])
}

/// Link público de resposta (/cotacao/<token>, no domínio raiz). É o que tira a
/// digitação da loja: o fornecedor abre no celular, preenche preço e prazo, e
/// pronto — sem conta, sem senha, sem instalar nada. Fornecedor de bebida não
/// cria login no ERP do cliente; esse é o fato que decide o desenho.
///
/// Tabela de CONTROLE, igual ao Invite: é lida ANTES de existir contexto de
/// tenant (o token é que diz qual é), então sempre via `basePrisma` com
/// tenantId explícito. Nada de negócio mora aqui — só o segredo do link.
model QuotationLink {
  id                  String @id @default(cuid())
  tenantId            String
  quotationSupplierId String @unique

  /// Segredo do link. Trocado a cada reenvio — reenviar invalida o anterior.
  token    String   @unique
  expiraEm DateTime

  /// Sinais de vida do fornecedor, sem depender de ele responder: abriu o link
  /// (leu) e enviou (respondeu). É o que separa "ignorou" de "está pensando".
  abertoEm     DateTime?
  respondidoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotationSupplier QuotationSupplier @relation(fields: [quotationSupplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ============================================================
// Análises salvas
// ============================================================

/// Uma consulta do motor de análises guardada com nome. O corpo é o DSL
/// (`src/lib/analises/schema.ts`), revalidado por Zod na leitura — DSL gravado
/// por uma versão antiga do schema falha limpo em vez de quebrar o motor.
///
/// `sistema = true` são os relatórios de fábrica (o catálogo curado); os demais
/// pertencem a quem criou e só aparecem para os outros quando compartilhados.
model SavedReport {
  id            String  @id @default(cuid())
  tenantId      String
  nome          String
  descricao     String?
  consulta      Json
  ownerUserId   String? // null = relatório de sistema
  compartilhado Boolean @default(false)
  sistema       Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ownerUserId])
}

// ============================================================
// Central de Relatórios
// ============================================================

/// Com que frequência um relatório agendado roda. A execução automática ainda
/// não existe (não há runner); o modelo entra agora para que agendar seja uma
/// tela e um job depois, e não uma migration em cima de dado vivo.
enum ReportFrequencia {
  DIARIO
  SEMANAL
  MENSAL
}

/// Relatório favoritado por uma pessoa. `relatorioId` é o slug do catálogo em
/// código (`src/lib/relatorios/catalogo.ts`), não uma FK: o catálogo é código
/// versionado, e um relatório que sai da lista não pode derrubar o favorito de
/// ninguém — ele só some da tela.
model ReportFavorite {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  relatorioId String
  criadoEm    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, relatorioId])
  @@index([tenantId])
  @@index([tenantId, userId])
}

/// Uma execução de relatório. É o que alimenta "última execução", "quantidade
/// de execuções" e a prateleira de histórico da Central.
///
/// Guarda os PARÂMETROS (período, loja, filtros), não o resultado: relatório é
/// pergunta, não fotografia — reabrir tem de trazer o dado de hoje.
model ReportRun {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  relatorioId String
  /// Parâmetros usados (periodo, de, ate, siteId, filtros) — para "executar de novo".
  parametros  Json?
  /// Como saiu: tela, csv, xlsx, pdf, impressao.
  formato     String   @default("tela")
  duracaoMs   Int?
  criadoEm    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, criadoEm])
  @@index([tenantId, relatorioId])
  @@index([tenantId, userId, criadoEm])
}

/// Envio automático de um relatório. Arquitetura pronta, runner ainda não:
/// `ativo` nasce false e nada lê `proximaExecucao` — quando o cron entrar, ele
/// varre esta tabela e usa os mesmos parâmetros da execução manual.
model ReportSchedule {
  id          String @id @default(cuid())
  tenantId    String
  relatorioId String
  nome        String

  ownerUserId String?
  frequencia  ReportFrequencia
  /// Hora local do disparo (0–23).
  hora        Int              @default(7)
  /// 0=domingo … 6=sábado. Só para SEMANAL.
  diaSemana   Int?
  /// 1–28. Só para MENSAL (28 é o teto para nunca pular mês).
  diaMes      Int?

  parametros    Json?
  formato       String  @default("pdf")
  /// Lista de destinos: [{ canal: "email" | "whatsapp", valor: "..." }].
  destinatarios Json    @default("[]")
  ativo         Boolean @default(false)

  proximaExecucao DateTime?
  ultimaExecucao  DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ativo, proximaExecucao])
}

/// Um jeito salvo de gerar um relatório: quais filtros, quais colunas, em que
/// ordem e agrupado por quê. É o "Relatório do contador", o "resumido", o "da
/// franquia" — o mesmo relatório com a configuração de sempre.
///
/// Guarda CONFIGURAÇÃO, nunca resultado: abrir um modelo tem de trazer o dado
/// de hoje, não a fotografia do dia em que foi salvo.
model ReportPreset {
  id          String @id @default(cuid())
  tenantId    String
  relatorioId String
  nome        String

  /// `ReportConfig` (src/lib/relatorios/config.ts) — validado ao ler e ao gravar.
  config Json

  ownerUserId   String?
  compartilhado Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, relatorioId, ownerUserId, nome])
  @@index([tenantId, relatorioId])
  @@index([tenantId, ownerUserId])
}
